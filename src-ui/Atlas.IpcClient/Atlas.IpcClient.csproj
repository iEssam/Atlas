<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Atlas.IpcClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.68.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Codegen from the single source-of-truth contract at repo-root proto/atlas.proto.
    GrpcServices=Client: generate the client stub + message types only (no server base).
    ProtoRoot pins the import root so the generated file lands predictably.
  -->
  <ItemGroup>
    <Protobuf Include="..\..\proto\atlas.proto"
              GrpcServices="Client"
              ProtoRoot="..\..\proto"
              Link="proto\atlas.proto" />
  </ItemGroup>

</Project>
