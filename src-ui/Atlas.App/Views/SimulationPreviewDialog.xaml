<ContentDialog
    x:Class="Atlas.App.Views.SimulationPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Atlas.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Preview impact"
    CloseButtonText="Close"
    DefaultButton="Close">

    <StackPanel Spacing="10" MinWidth="460" MaxWidth="560">
        <TextBlock Text="RULE SIMULATION / NO CHANGES APPLIED"
                   Style="{StaticResource AtlasSectionLabelStyle}" />
        <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <views:SimulationResultView x:Name="SimView" MinHeight="120" MaxHeight="440" />
    </StackPanel>
</ContentDialog>
