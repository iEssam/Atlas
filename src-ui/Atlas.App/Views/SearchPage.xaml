<Page
    x:Class="Atlas.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Search" Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="One query across processes, events, and bookmarks. Grouped by kind." />
        </StackPanel>

        <AutoSuggestBox Grid.Row="1"
                        x:Name="SearchBox"
                        AutomationProperties.Name="Search processes, events, and bookmarks"
                        PlaceholderText="Search processes, events, bookmarks…"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QuerySubmitted="SearchBox_QuerySubmitted" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Results / empty / unavailable -->
        <Grid Grid.Row="3">
            <!-- Unavailable placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Search unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Text="The connected service is too old to answer search."
                           Style="{StaticResource AtlasEmptyStateBodyStyle}" />
            </StackPanel>

            <!-- Grouped results -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultGroup">
                            <StackPanel Margin="0,0,0,20">
                                <Grid ColumnSpacing="8" Margin="0,0,0,4"
                                      BorderBrush="{ThemeResource AtlasLineBrush}"
                                      BorderThickness="0,0,0,1" Padding="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Icon}" FontSize="14"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AtlasDimBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource AtlasSectionLabelStyle}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SearchResultItem">
                                            <Border BorderBrush="{ThemeResource AtlasLineBrush}"
                                                    BorderThickness="0,0,0,1" Padding="24,9,8,9">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Icon}" FontSize="14"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource AtlasDimBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind Primary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Secondary}"
                                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
