<Page
    x:Class="Atlas.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title + connection status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Overview" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
        </StackPanel>

        <!-- Gauge cards -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Processor" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <ProgressBar Minimum="0" Maximum="100" Margin="0,8,0,0"
                                 Value="{x:Bind ViewModel.CpuPercent, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Memory -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Memory" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ProgressBar Minimum="0" Maximum="100" Margin="0,8,0,0"
                                 Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind CommitLine, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Counts -->
            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="System" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="12" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind ViewModel.ThreadCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{x:Bind ViewModel.HandleCount, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Processes"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Threads"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Handles"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top consumers header -->
        <TextBlock Grid.Row="2" Text="Top consumers" Margin="0,8,0,0"
                   Style="{StaticResource SubtitleTextBlockStyle}" />

        <!-- Top consumers list -->
        <ItemsControl Grid.Row="3"
                      ItemsSource="{x:Bind ViewModel.TopConsumers5, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConsumerRowViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,10" Margin="0,0,0,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{x:Bind ImageName, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind PidText, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       HorizontalTextAlignment="Right"
                                       Text="{x:Bind CpuText, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       HorizontalTextAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind WorkingSetText, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
