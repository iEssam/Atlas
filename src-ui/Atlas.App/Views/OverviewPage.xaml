<Page
    x:Class="Atlas.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="OBSERVE / SYSTEM" Style="{StaticResource AtlasEyebrowStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Overview" Style="{StaticResource AtlasPageHeadingStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,0,0,3">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{ThemeResource AtlasCyanBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource AtlasMonoMutedStyle}"
                               Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Live system summary and top consumers. Measured values only — no health score." />
        </StackPanel>

        <!-- ===== Metric strip ===== -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border Grid.Column="0" Style="{StaticResource AtlasMetricCellStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="PROCESSOR" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" />
                    <ProgressBar Minimum="0" Maximum="100" Margin="0,4,0,0"
                                 Value="{x:Bind ViewModel.CpuPercent, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Memory -->
            <Border Grid.Column="1" Style="{StaticResource AtlasMetricCellStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="MEMORY" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="20" />
                    <ProgressBar Minimum="0" Maximum="100" Margin="0,4,0,0"
                                 Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                               Text="{x:Bind CommitLine, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Counts -->
            <Border Grid.Column="2" Style="{StaticResource AtlasMetricCellStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="SYSTEM" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <Grid ColumnSpacing="12" RowSpacing="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}"
                                   Style="{StaticResource AtlasMetricValueStyle}" FontSize="22" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind ViewModel.ThreadCount, Mode=OneWay}"
                                   Style="{StaticResource AtlasMetricValueStyle}" FontSize="22" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{x:Bind ViewModel.HandleCount, Mode=OneWay}"
                                   Style="{StaticResource AtlasMetricValueStyle}" FontSize="22" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PROCESSES"
                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="THREADS"
                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="HANDLES"
                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Top consumers ===== -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="TOP CONSUMERS  ·  BY CPU"
                       Style="{StaticResource AtlasSectionLabelStyle}" Margin="12,0,0,0" />
            <TextBlock Grid.Column="2" Text="CPU" HorizontalTextAlignment="Right"
                       Style="{StaticResource AtlasColumnHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="WORKING SET" HorizontalTextAlignment="Right"
                       Style="{StaticResource AtlasColumnHeaderStyle}" />
        </Grid>

        <!-- Top consumers list -->
        <Border Grid.Row="3" Style="{StaticResource AtlasPanelFlatStyle}" VerticalAlignment="Top">
            <ItemsControl ItemsSource="{x:Bind ViewModel.TopConsumers5, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsumerRowViewModel">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="12,9">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{x:Bind ImageName, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind PidText, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           HorizontalTextAlignment="Right"
                                           Style="{StaticResource AtlasMonoStyle}"
                                           Text="{x:Bind CpuText, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                           HorizontalTextAlignment="Right"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind WorkingSetText, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Page>
