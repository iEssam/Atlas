<Page
    x:Class="Atlas.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:controls="using:Atlas.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="16,48,16,16" RowSpacing="18"
              SizeChanged="PageLayout_SizeChanged">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="Small" />
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageLayout.Padding" Value="24,48,24,24" />
                            <Setter Target="MetricColumn1.Width" Value="*" />
                            <Setter Target="MetricRow1.Height" Value="Auto" />
                            <Setter Target="GraphicsMetric.(Grid.Row)" Value="0" />
                            <Setter Target="GraphicsMetric.(Grid.Column)" Value="1" />
                            <Setter Target="MemoryMetric.(Grid.Row)" Value="1" />
                            <Setter Target="MemoryMetric.(Grid.Column)" Value="0" />
                            <Setter Target="ProcessesMetric.(Grid.Row)" Value="1" />
                            <Setter Target="ProcessesMetric.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Large">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1008" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageLayout.Padding" Value="24" />
                            <Setter Target="MetricColumn1.Width" Value="*" />
                            <Setter Target="MetricColumn2.Width" Value="*" />
                            <Setter Target="MetricColumn3.Width" Value="*" />
                            <Setter Target="GraphicsMetric.(Grid.Row)" Value="0" />
                            <Setter Target="GraphicsMetric.(Grid.Column)" Value="1" />
                            <Setter Target="MemoryMetric.(Grid.Row)" Value="0" />
                            <Setter Target="MemoryMetric.(Grid.Column)" Value="2" />
                            <Setter Target="ProcessesMetric.(Grid.Row)" Value="0" />
                            <Setter Target="ProcessesMetric.(Grid.Column)" Value="3" />
                            <Setter Target="EvidenceColumn.Width" Value="2*" />
                            <Setter Target="ConsumersColumn.Width" Value="3*" />
                            <Setter Target="ConsumersSection.(Grid.Row)" Value="0" />
                            <Setter Target="ConsumersSection.(Grid.Column)" Value="1" />
                            <Setter Target="WideConsumers.Visibility" Value="Visible" />
                            <Setter Target="CompactConsumers.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Overview"
                               Style="{StaticResource AtlasPageHeadingStyle}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Live system evidence and the processes that deserve attention."
                               Style="{StaticResource AtlasPageDescriptionStyle}"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.RecencyText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="180"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <Grid x:Name="ReadingGrid" Grid.Row="1" RowSpacing="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="MetricColumn1" Width="0" />
                    <ColumnDefinition x:Name="MetricColumn2" Width="0" />
                    <ColumnDefinition x:Name="MetricColumn3" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="MetricRow1" Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="ProcessorMetric" Grid.Row="0" Grid.Column="0" Spacing="2" Padding="8,6">
                    <TextBlock Text="Processor" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="22" />
                </StackPanel>
                <StackPanel x:Name="GraphicsMetric" Grid.Row="1" Grid.Column="0" Spacing="2" Padding="8,6">
                    <TextBlock Text="Graphics" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.GpuText, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="22" />
                </StackPanel>
                <StackPanel x:Name="MemoryMetric" Grid.Row="2" Grid.Column="0" Spacing="2" Padding="8,6">
                    <TextBlock Text="Memory" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="18" />
                    <TextBlock Text="{x:Bind CommitLine, Mode=OneWay}"
                               Style="{StaticResource AtlasMonoMutedStyle}" />
                </StackPanel>
                <StackPanel x:Name="ProcessesMetric" Grid.Row="3" Grid.Column="0" Spacing="2" Padding="8,6">
                    <TextBlock Text="Processes" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="22" />
                    <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="What Atlas found"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Prioritized interpretation of the latest measured evidence"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <Border Style="{StaticResource AtlasPanelStyle}" Padding="20,18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    Visibility="{x:Bind ViewModel.IsInsightsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ProgressRing IsActive="True" Width="18" Height="18" />
                            <TextBlock Text="Interpreting current measurements..."
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <StackPanel Spacing="5"
                                    Visibility="{x:Bind ViewModel.IsInsightsUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Insights are unavailable"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.InsightsStatus, Mode=OneWay}"
                                       Style="{StaticResource AtlasEmptyStateBodyStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button Content="Retry"
                                    Click="RefreshTrace_Click"
                                    HorizontalAlignment="Left" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.InsightsStatus, Mode=OneWay}"
                                   Style="{StaticResource AtlasEmptyStateBodyStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsInsightsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Insights, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasInsights, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Prioritized system insights">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverviewInsightViewModel">
                                    <Grid ColumnSpacing="14" Margin="0,0,0,14"
                                          AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}"
                                                  FontSize="18"
                                                  Margin="0,2,0,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Top"
                                                  Foreground="{x:Bind SeverityToken, Converter={StaticResource SeverityToBrush}}" />
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind StatusText}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ConfidenceText}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.HeadingLevel="Level3" />
                                            <TextBlock Text="{x:Bind Observation}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Significance}"
                                                       Foreground="{ThemeResource AtlasMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind EvidenceText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ScopeText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind RecommendationText}"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasRecommendationText, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{x:Bind ActionText}"
                                                    Style="{StaticResource AtlasGhostButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    Click="InsightAction_Click"
                                                    Visibility="{x:Bind CanOpenEvidence, Converter={StaticResource BoolToVisibility}}"
                                                    AutomationProperties.Name="{x:Bind ActionText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind ViewModel.InsightsStatus, Mode=OneWay}"
                                   Foreground="{ThemeResource AtlasAmberBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsInsightsStale, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.LiveSetting="Polite" />

                        <TextBlock Text="{x:Bind ViewModel.InsightCoverage, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasInsights, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3" RowSpacing="18" ColumnSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EvidenceColumn" Width="*" />
                    <ColumnDefinition x:Name="ConsumersColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="EvidenceSection" Grid.Row="0" Grid.Column="0" Spacing="8">
                    <TextBlock Text="Recent evidence"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />

                    <Border Style="{StaticResource AtlasInsetStyle}"
                            Visibility="{x:Bind ViewModel.HasEvidence, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsEvidenceLoading, Mode=OneWay}"
                                          Width="16" Height="16"
                                          Visibility="{x:Bind ViewModel.IsEvidenceLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <FontIcon Glyph="&#xE73E;" FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind ViewModel.IsEvidenceClear, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{x:Bind ViewModel.EvidenceStatus, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Evidence, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasEvidence, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Recent incidents, privacy activity, and system changes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OverviewEvidenceMarker">
                                <Button Style="{StaticResource AtlasGhostButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="EvidenceRow_Click"
                                        AutomationProperties.Name="{x:Bind AutomationName}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Summary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind TimeText}"
                                                   Style="{StaticResource AtlasMonoMutedStyle}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="ConsumersSection" Grid.Row="1" Grid.Column="0" Spacing="8">
                    <TextBlock Text="Top consumers by CPU"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />

                    <StackPanel x:Name="WideConsumers" Visibility="Collapsed" Spacing="2">
                        <Grid Padding="12,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Style="{StaticResource AtlasColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource AtlasColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="CPU" TextAlignment="Right"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                            <TextBlock Grid.Column="3" Text="Memory" TextAlignment="Right"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopConsumers5, Mode=OneWay}"
                                      AutomationProperties.Name="Top CPU consumers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsumerRowViewModel">
                                    <Button Style="{StaticResource AtlasGhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="ConsumerRow_Click"
                                            AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="112" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:AppIcon ProcessId="{x:Bind Pid}" Width="20" Height="20"
                                                                  AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Text="{x:Bind ImageName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind PidText, Mode=OneWay}"
                                                       Style="{StaticResource AtlasMonoMutedStyle}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind CpuText, Mode=OneWay}"
                                                       TextAlignment="Right" Style="{StaticResource AtlasMonoStyle}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind WorkingSetText, Mode=OneWay}"
                                                       TextAlignment="Right" Style="{StaticResource AtlasMonoMutedStyle}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl x:Name="CompactConsumers"
                                  ItemsSource="{x:Bind ViewModel.TopConsumers5, Mode=OneWay}"
                                  AutomationProperties.Name="Top CPU consumers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConsumerRowViewModel">
                                <Button Style="{StaticResource AtlasGhostButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="ConsumerRow_Click"
                                        AutomationProperties.Name="{x:Bind AutomationName}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:AppIcon ProcessId="{x:Bind Pid}" Width="20" Height="20"
                                                                  AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Text="{x:Bind ImageName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind PidText, Mode=OneWay}"
                                                           Style="{StaticResource AtlasMonoMutedStyle}" />
                                                <TextBlock Text="{x:Bind WorkingSetText, Mode=OneWay}"
                                                           Style="{StaticResource AtlasMonoMutedStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}"
                                                   Style="{StaticResource AtlasMonoStyle}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource AtlasPanelStyle}" Padding="18,16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Last 15 minutes"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="Measured averages and recorded min/max ranges"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource AtlasGhostButtonStyle}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Refresh system trace"
                                Click="RefreshTrace_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="100%" Style="{StaticResource CaptionTextBlockStyle}"
                                       FontSize="10" VerticalAlignment="Top" />
                            <TextBlock Text="0%" Style="{StaticResource CaptionTextBlockStyle}"
                                       FontSize="10" VerticalAlignment="Bottom" />
                        </Grid>
                        <Canvas x:Name="TraceCanvas"
                                Grid.Row="0" Grid.Column="1"
                                Background="Transparent"
                                AutomationProperties.Name="{x:Bind ViewModel.TraceAutomationSummary, Mode=OneWay}"
                                SizeChanged="TraceCanvas_SizeChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="15 min ago"
                                   Style="{StaticResource CaptionTextBlockStyle}" FontSize="10" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Now"
                                   Style="{StaticResource CaptionTextBlockStyle}" FontSize="10"
                                   HorizontalAlignment="Right" />

                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsTraceLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ProgressRing IsActive="True" Width="20" Height="20" />
                            <TextBlock Text="Loading system trace..." Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsTraceEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Recording has just started."
                                       Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                            <TextBlock Text="Historical samples will appear here as Atlas records them."
                                       Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsTraceUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Historical evidence unavailable"
                                       Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TraceStatus, Mode=OneWay}"
                                       Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                            <Button Content="Retry" Click="RefreshTrace_Click" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="CPU · solid" Foreground="{ThemeResource AtlasCyanBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="Memory · dotted" Foreground="{ThemeResource AtlasGreenBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.GpuHistoryLabel, Mode=OneWay}"
                                       Foreground="{ThemeResource AtlasAmberBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TraceStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="460" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
