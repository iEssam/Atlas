<Page
    x:Class="Atlas.App.Views.FileLockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:controls="using:Atlas.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot" Padding="12" RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="PathBox.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="BrowseButton.(Grid.Row)" Value="1" />
                        <Setter Target="BrowseButton.(Grid.Column)" Value="0" />
                        <Setter Target="SearchButton.(Grid.Row)" Value="1" />
                        <Setter Target="SearchButton.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="20" />
                        <Setter Target="PathBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BrowseButton.(Grid.Row)" Value="0" />
                        <Setter Target="BrowseButton.(Grid.Column)" Value="1" />
                        <Setter Target="SearchButton.(Grid.Row)" Value="0" />
                        <Setter Target="SearchButton.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="File Lock Search" Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Find which processes are holding a file open. Atlas reports owners without closing their file handles." />
        </StackPanel>

        <!-- ===== Path input row ===== -->
        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="PathBox"
                     AutomationProperties.Name="File path to search"
                     PlaceholderText="Paste a full file path, or use Browse…"
                     FontFamily="{ThemeResource AtlasMonoFontFamily}"
                     Text="{x:Bind ViewModel.PathInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnPathKeyDown" />
            <Button x:Name="BrowseButton" Grid.Column="1" Click="OnBrowseClick"
                    Style="{StaticResource AtlasGhostButtonStyle}"
                    AutomationProperties.Name="Browse for a file">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock Text="Browse…" />
                </StackPanel>
            </Button>
            <Button x:Name="SearchButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                    Click="OnSearchClick"
                    AutomationProperties.Name="Search for file owners">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock Text="Search" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Status line ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource AtlasMonoMutedStyle}"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- ===== Read-only capability notice ===== -->
        <InfoBar Grid.Row="3"
                 IsOpen="{x:Bind ViewModel.ShowReadOnlyNotice, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Informational"
                 Title="Read-only"
                 Message="Atlas can identify the owning processes, but it does not close or release their file handles. Inspect an owner for more evidence." />

        <!-- ===== Results / states ===== -->
        <Grid Grid.Row="4">
            <!-- Unavailable (server too old / path not found / access denied) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AtlasAmberBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Couldn't complete the search"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}"
                           Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           MaxWidth="420" />
            </StackPanel>

            <!-- Empty (nothing holding the file - a clean, positive result) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE73E;" FontSize="28"
                          Foreground="{ThemeResource AtlasGreenBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Nothing is using this file"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                           Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           MaxWidth="420" />
            </StackPanel>

            <!-- Owner list -->
            <ListView AutomationProperties.Name="Processes using this file"
                      ItemsSource="{x:Bind ViewModel.Owners, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResourceOwnerItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="12,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:AppIcon Grid.Column="0" ExecutablePath="{x:Bind ImagePath}"
                                                  ProcessId="{x:Bind Pid}" Width="22" Height="22"
                                                  Margin="2,0,4,0"
                                                  AutomationProperties.AccessibilityView="Raw" />

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind ImageName}"
                                                   Style="{StaticResource AtlasMonoStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind PidText}"
                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource AtlasStatusPillStyle}">
                                            <TextBlock Text="{x:Bind KindText}"
                                                       Style="{StaticResource AtlasSectionLabelStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ImagePath}" />
                                </StackPanel>

                                <Button Grid.Column="2" VerticalAlignment="Center"
                                        Style="{StaticResource AtlasGhostButtonStyle}"
                                        Click="OnInspectOwnerClick"
                                        AutomationProperties.Name="Inspect this process">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                        <TextBlock Text="Inspect" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
