<Page
    x:Class="Atlas.App.Views.LiveActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="OBSERVE / LIVE ACTIVITY" Style="{StaticResource AtlasEyebrowStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Live Activity" Style="{StaticResource AtlasPageHeadingStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,0,0,3">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{ThemeResource AtlasCyanBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource AtlasMonoMutedStyle}"
                               Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Live per-process measurements streaming from the service. Right-click a row for guarded actions." />
        </StackPanel>

        <!-- Capabilities line -->
        <TextBlock Grid.Row="1"
                   Style="{StaticResource AtlasMonoMutedStyle}"
                   Text="{x:Bind CapabilitiesText, Mode=OneWay}" />

        <!-- ===== System gauges strip ===== -->
        <Border Grid.Row="2" Style="{StaticResource AtlasMetricCellStyle}" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel Spacing="4">
                    <TextBlock Text="SYSTEM CPU" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind CpuText, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="18" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="MEMORY" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind MemText, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="18" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="PROCESSES" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="18" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="THREADS" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ThreadCount, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="18" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="HANDLES" Style="{StaticResource AtlasSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.HandleCount, Mode=OneWay}"
                               Style="{StaticResource AtlasMetricValueStyle}" FontSize="18" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Process table ===== -->
        <Grid Grid.Row="3" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8"
                  BorderBrush="{ThemeResource AtlasLineBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource AtlasColumnHeaderStyle}" />
                <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource AtlasColumnHeaderStyle}" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="CPU %" Style="{StaticResource AtlasColumnHeaderStyle}" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="WS MB" Style="{StaticResource AtlasColumnHeaderStyle}" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="PRIVATE MB" Style="{StaticResource AtlasColumnHeaderStyle}" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="THREADS" Style="{StaticResource AtlasColumnHeaderStyle}" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="6" Text="HANDLES" Style="{StaticResource AtlasColumnHeaderStyle}" HorizontalTextAlignment="Right" />
            </Grid>

            <!-- Virtualized rows -->
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                      SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderBrush" Value="{ThemeResource AtlasLineBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                        <Grid ColumnSpacing="8" DoubleTapped="ProcessRow_DoubleTapped">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Inspect" Click="ProcessInspect_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7B3;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Close window" Tag="close"
                                                    Click="ProcessAction_Click" />
                                    <MenuFlyoutItem Text="Suspend" Tag="suspend"
                                                    Click="ProcessAction_Click" />
                                    <MenuFlyoutItem Text="Resume" Tag="resume"
                                                    Click="ProcessAction_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="End process" Tag="terminate"
                                                    Click="ProcessAction_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{x:Bind ImageName, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                       Text="{x:Bind Pid}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource AtlasMonoStyle}"
                                       Text="{x:Bind CpuText, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       Style="{StaticResource AtlasMonoStyle}"
                                       Text="{x:Bind WorkingSetText, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                       Text="{x:Bind PrivateText, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center"
                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                       Text="{x:Bind ThreadCount, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="6" VerticalAlignment="Center"
                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                       Text="{x:Bind HandleCount, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
