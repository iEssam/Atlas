<Page
    x:Class="Atlas.App.Views.LiveActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:local="using:Atlas.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Style x:Key="ActivityHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,7" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Activity" Style="{StaticResource AtlasPageHeadingStyle}" />
                <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                           HorizontalAlignment="Left"
                           Text="Keep process positions stable, follow selected applications, and inspect measured changes over time." />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="7"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D9;"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar Severity="Warning"
                     IsOpen="{x:Bind ViewModel.ShowConnectionWarning, Mode=OneWay}"
                     IsClosable="False"
                     Title="Live activity is unavailable"
                     Message="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
            <InfoBar x:Name="InteractionInfoBar"
                     Severity="Informational"
                     IsOpen="{x:Bind ViewModel.HasInteractionMessage, Mode=OneWay}"
                     IsClosable="True"
                     Closed="InteractionInfoBar_Closed"
                     Message="{x:Bind ViewModel.InteractionMessage, Mode=OneWay}" />
        </StackPanel>

        <CommandBar Grid.Row="2"
                    Background="Transparent"
                    IsOpen="True"
                    DefaultLabelPosition="Right">
            <CommandBar.Content>
                <AutoSuggestBox x:Name="ProcessSearch"
                                Width="320"
                                AutomationProperties.Name="Filter live processes"
                                PlaceholderText="Filter by process name or PID"
                                TextChanged="ProcessSearch_TextChanged">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </CommandBar.Content>

            <AppBarToggleButton x:Name="PauseButton"
                                Label="{x:Bind ViewModel.PauseActionText, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                                AutomationProperties.Name="Pause or resume live values"
                                Click="PauseButton_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="{x:Bind ViewModel.PauseActionGlyph, Mode=OneWay}" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>

            <AppBarButton Label="{x:Bind ViewModel.TrackActionText, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.CanTrackSelection, Mode=OneWay}"
                          AutomationProperties.Name="Track selected application"
                          Click="TrackSelected_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarButton Label="Inspect"
                          IsEnabled="{x:Bind ViewModel.CanInspectSelection, Mode=OneWay}"
                          AutomationProperties.Name="Inspect selected process"
                          Click="InspectSelected_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7B3;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Service details">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="430" Spacing="10">
                                <TextBlock Text="Service details"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Version" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.ServiceVersion, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Live source" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.ConnectionSourceText, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Text="Capabilities" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CapabilityFlags, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource AtlasMonoMutedStyle}" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="ActivitySelector"
                         SelectionChanged="ActivitySelector_SelectionChanged">
                <SelectorBarItem x:Name="AllProcessesSelector"
                                 Text="All processes"
                                 Icon="List"
                                 IsSelected="True" />
                <SelectorBarItem x:Name="TrackedSelector"
                                 Text="Tracked"
                                 Icon="Favorite" />
                <SelectorBarItem x:Name="ChangesSelector"
                                 Text="Changes"
                                 Icon="Clock" />
            </SelectorBar>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind ViewModel.VisibleCountText, Mode=OneWay}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource AtlasPanelFlatStyle}">
            <Grid Padding="16,12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="System CPU" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind CpuText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Memory" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind MemText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="System GPU" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind GpuText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="Processes" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.SystemInsightText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="5" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ProcessListHost" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Padding="8,0"
                      ColumnSpacing="6"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Tag="Name" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by process name" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.NameHeader, Mode=OneWay}"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                    <Button Grid.Column="2" Tag="Pid" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by process ID" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.PidHeader, Mode=OneWay}"
                                   HorizontalTextAlignment="Right"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                    <Button Grid.Column="3" Tag="Cpu" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by current CPU" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.CpuHeader, Mode=OneWay}"
                                   HorizontalTextAlignment="Right"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                    <Button Grid.Column="4" Tag="AverageCpu" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by one-minute CPU average" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.AverageCpuHeader, Mode=OneWay}"
                                   HorizontalTextAlignment="Right"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                    <Button Grid.Column="5" Tag="Gpu" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by current GPU" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.GpuHeader, Mode=OneWay}"
                                   HorizontalTextAlignment="Right"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                    <Button Grid.Column="6" Tag="WorkingSet" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by memory" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.MemoryHeader, Mode=OneWay}"
                                   HorizontalTextAlignment="Right"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                    <Button Grid.Column="7" Tag="MemoryDelta" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by one-minute memory change" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.MemoryDeltaHeader, Mode=OneWay}"
                                   HorizontalTextAlignment="Right"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                    <Button Grid.Column="8" Tag="Disk" Style="{StaticResource ActivityHeaderButtonStyle}"
                            AutomationProperties.Name="Sort by disk activity" Click="SortHeader_Click">
                        <TextBlock Text="{x:Bind ViewModel.DiskHeader, Mode=OneWay}"
                                   HorizontalTextAlignment="Right"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Button>
                </Grid>

                <ListView x:Name="ProcessList"
                          Grid.Row="1"
                          AutomationProperties.Name="Live processes"
                          ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                          SelectionChanged="ProcessList_SelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AtlasRowContainerStyle}">
                            <Setter Property="Padding" Value="8,5" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                            <Grid ColumnSpacing="6" DoubleTapped="ProcessRow_DoubleTapped">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind TrackActionText, Mode=OneWay}"
                                                        Click="ProcessTrack_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="{x:Bind TrackGlyph, Mode=OneWay}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Inspect"
                                                        IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                                        Click="ProcessInspect_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7B3;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Close window" Tag="close"
                                                        IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                                        Click="ProcessAction_Click" />
                                        <MenuFlyoutItem Text="Suspend" Tag="suspend"
                                                        IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                                        Click="ProcessAction_Click" />
                                        <MenuFlyoutItem Text="Resume" Tag="resume"
                                                        IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                                        Click="ProcessAction_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="End process" Tag="terminate"
                                                        IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                                        Click="ProcessAction_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" MinWidth="170" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="{x:Bind TrackActionText, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind TrackActionText, Mode=OneWay}"
                                        Click="ProcessTrackButton_Click">
                                    <FontIcon Glyph="{x:Bind TrackGlyph, Mode=OneWay}" FontSize="13" />
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ImageName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Ended"
                                               Visibility="{x:Bind local:LiveActivityPage.EndedVisibility(IsRunning), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Pid}"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CpuText, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoStyle}"
                                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind AverageCpuText, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{x:Bind GpuText, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoStyle}"
                                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{x:Bind WorkingSetText, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoStyle}"
                                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{x:Bind MemoryDeltaText, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="8" Text="{x:Bind DiskText, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="ProcessEmptyState"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                    <ProgressRing x:Name="InitialSnapshotProgress" Width="22" Height="22" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                               Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                               Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ChangesHost" Grid.Column="0" Visibility="Collapsed">
                <ListView AutomationProperties.Name="Measured activity changes"
                          ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AtlasRowContainerStyle}">
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityChangeViewModel">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind TimeText}"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           VerticalAlignment="Center" />
                                <FontIcon Grid.Column="1" Glyph="{x:Bind IconGlyph}"
                                          FontSize="13" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind KindText}"
                                           HorizontalTextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="ChangesEmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="No measured changes yet"
                               Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                    <TextBlock Text="Starts, exits, tracking changes, and measured CPU or memory changes will appear here."
                               Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                </StackPanel>
            </Grid>

            <Border x:Name="DetailsPane"
                    Grid.Column="1"
                    Style="{StaticResource AtlasPanelFlatStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="18">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding ImageName}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="32" Height="32" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Content="{Binding TrackGlyph}"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    AutomationProperties.Name="{Binding TrackActionText}"
                                    ToolTipService.ToolTip="{Binding TrackActionText}"
                                    Click="TrackSelected_Click" />
                        </Grid>

                        <Grid ColumnSpacing="18" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="CPU now" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="CPU peak, 1 minute" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding PeakCpuText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock Text="Memory" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding WorkingSetText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                <TextBlock Text="Memory change, 1 minute" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding MemoryDeltaText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Live trace" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="TraceMetricPicker"
                                          Grid.Column="1"
                                          AutomationProperties.Name="Live trace metric"
                                          SelectedIndex="0"
                                          SelectionChanged="TraceMetricPicker_SelectionChanged">
                                    <ComboBoxItem Content="CPU" />
                                    <ComboBoxItem Content="Memory" />
                                    <ComboBoxItem Content="GPU" />
                                    <ComboBoxItem Content="Disk activity" />
                                </ComboBox>
                            </Grid>
                            <Grid Height="150">
                                <Canvas x:Name="SelectedTraceCanvas"
                                        Background="Transparent"
                                        AutomationProperties.Name="Selected process live trace"
                                        SizeChanged="SelectedTraceCanvas_SizeChanged" />
                                <TextBlock x:Name="TraceEmptyText"
                                           Text="Waiting for live samples"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Current" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="TraceCurrentText" Style="{StaticResource AtlasMonoStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Average" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="TraceAverageText" Style="{StaticResource AtlasMonoStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Peak" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="TracePeakText" Style="{StaticResource AtlasMonoStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Process details" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="12" RowSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="PID" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Pid}" Style="{StaticResource AtlasMonoStyle}" />
                                <TextBlock Grid.Row="1" Text="Threads" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThreadText}" Style="{StaticResource AtlasMonoStyle}" />
                                <TextBlock Grid.Row="2" Text="Handles" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HandleText}" Style="{StaticResource AtlasMonoStyle}" />
                                <TextBlock Grid.Row="3" Text="Private memory" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PrivateText}" Style="{StaticResource AtlasMonoStyle}" />
                                <TextBlock Grid.Row="4" Text="GPU memory" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GpuMemoryText}" Style="{StaticResource AtlasMonoStyle}" />
                            </Grid>
                        </StackPanel>

                        <Button Content="Open process inspector"
                                IsEnabled="{Binding IsRunning}"
                                HorizontalAlignment="Stretch"
                                Click="InspectSelected_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
