<Page
    x:Class="Atlas.App.Views.LiveActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title + connection status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Live Activity" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
        </StackPanel>

        <!-- Capabilities line -->
        <TextBlock Grid.Row="1"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind CapabilitiesText, Mode=OneWay}" />

        <!-- System gauges header -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="2" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel>
                    <TextBlock Text="System CPU" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind CpuText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Memory" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind MemText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Processes" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Threads" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ThreadCount, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Handles" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.HandleCount, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Process table -->
        <Grid Grid.Row="3" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="PID" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="CPU %" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="WS MB" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Private MB" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="Threads" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                <TextBlock Grid.Column="6" Text="Handles" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
            </Grid>

            <!-- Virtualized rows -->
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                      SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                        <Grid ColumnSpacing="8" DoubleTapped="ProcessRow_DoubleTapped">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Inspect" Click="ProcessInspect_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7B3;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Close window" Tag="close"
                                                    Click="ProcessAction_Click" />
                                    <MenuFlyoutItem Text="Suspend" Tag="suspend"
                                                    Click="ProcessAction_Click" />
                                    <MenuFlyoutItem Text="Resume" Tag="resume"
                                                    Click="ProcessAction_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="End process" Tag="terminate"
                                                    Click="ProcessAction_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ImageName, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Pid}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{x:Bind CpuText, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{x:Bind WorkingSetText, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{x:Bind PrivateText, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{x:Bind ThreadCount, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="{x:Bind HandleCount, Mode=OneWay}"
                                       HorizontalTextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
