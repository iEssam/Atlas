<ContentDialog
    x:Class="Atlas.App.Views.ProfileEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Atlas.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <StackPanel Spacing="14" MinWidth="440" MaxWidth="520" Margin="0,4,0,0">

        <StackPanel Spacing="4">
            <TextBlock Text="Profile name" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="NameBox"
                     AutomationProperties.Name="Profile name"
                     PlaceholderText="e.g. Gaming" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Power mode" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="PowerModeBox"
                      AutomationProperties.Name="Power mode"
                      HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="No power-mode change" Tag="" />
                <ComboBoxItem Content="Power saver" Tag="PowerSaver" />
                <ComboBoxItem Content="Balanced" Tag="Balanced" />
                <ComboBoxItem Content="High performance" Tag="HighPerformance" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Member rules" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Activating this profile enables the rules you check here."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock x:Name="NoRulesNote"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="No rules exist yet. Create rules first, then add them to a profile." />

            <ListView x:Name="RulesList"
                      AutomationProperties.Name="Member rules"
                      MaxHeight="240"
                      SelectionMode="None"
                      Margin="0,4,0,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:SelectableRule">
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind Name}">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Summary}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <InfoBar x:Name="ValidationBar" IsOpen="False" IsClosable="False"
                 Severity="Error" Title="Check the profile" />
    </StackPanel>
</ContentDialog>
