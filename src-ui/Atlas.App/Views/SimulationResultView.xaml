<UserControl
    x:Class="Atlas.App.Views.SimulationResultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:controls="using:Atlas.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status / summary line -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Width="16" Height="16" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Style="{StaticResource AtlasMonoMutedStyle}" />
        </StackPanel>

        <!-- Conflicts (PRD §9.7.6) -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasConflicts, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Warning"
                 Title="Conflicts with other rules">
            <InfoBar.Content>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Conflicts, Mode=OneWay}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </InfoBar.Content>
        </InfoBar>

        <!-- Protected-targets legend: calm, explains the marked rows -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    Visibility="{x:Bind ViewModel.HasBlocked, Mode=OneWay}">
            <FontIcon Glyph="&#xE72E;" FontSize="14"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                      VerticalAlignment="Center" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Highlighted rows are system-critical - Atlas won't touch them, even with this rule enabled." />
        </StackPanel>

        <!-- Unavailable / empty placeholders -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,4"
                    Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7BA;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Preview unavailable"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The connected service is too old to simulate rules. You can still save the rule; the preview will work once the service is updated." />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,4"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock Text="Nothing running matches"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="No processes are running that this rule would change right now. It will apply automatically when a matching process starts." />
        </StackPanel>

        <!-- Affected-process table -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                          AutomationProperties.Name="Simulated affected processes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SimulatedTargetRow">
                        <Border Margin="0,3"
                                CornerRadius="2"
                                Padding="12,8"
                                Background="{x:Bind Blocked, Converter={StaticResource BlockedToBrush}}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="2.4*" />
                                </Grid.ColumnDefinitions>

                                <!-- Process identity -->
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:AppIcon ProcessId="{x:Bind Pid}" Width="20" Height="20"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                        <FontIcon Glyph="&#xE72E;" FontSize="13"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind Blocked}" />
                                        <TextBlock Text="{x:Bind ImageName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind PidText}"
                                               Style="{StaticResource AtlasMonoMutedStyle}" />
                                </StackPanel>

                                <!-- Blocked: the calm protection line -->
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Visibility="{x:Bind Blocked}"
                                           Text="{x:Bind BlockedReason}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Actionable: the current→new transitions -->
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"
                                            Visibility="{x:Bind IsActionable}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Priority" MinWidth="64"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind PriorityTransition}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Cores" MinWidth="64"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind AffinityTransition}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Eco" MinWidth="64"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind EcoText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
