<Page
    x:Class="Atlas.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + New -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Rules" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock VerticalAlignment="Bottom"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Performance &amp; optimization rules" />
                <Border x:Name="DemoBadge" Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="4" Padding="8,2">
                    <TextBlock Text="Demo data" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
            <Button x:Name="NewRuleButton"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="New rule"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewRule_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New rule" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status line -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Rules table / states -->
        <Grid Grid.Row="2">
            <!-- Unavailable -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Rules unavailable"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="The connected service is too old to manage rules. Update the Atlas service to use the rules engine."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="420"
                           HorizontalTextAlignment="Center" />
            </StackPanel>

            <!-- Empty -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE9F5;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No rules yet"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Create a rule to steer a process's priority, cores, or efficiency mode. You can always preview the impact before it applies."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="420"
                           HorizontalTextAlignment="Center" />
            </StackPanel>

            <Grid Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16,4,16,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" MinWidth="70" />
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="Auto" MinWidth="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Match" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="When" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Action" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Prec." Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="Enabled" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- Rows -->
                <ListView Grid.Row="1"
                          AutomationProperties.Name="Rules table"
                          ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleRowViewModel">
                            <Grid ColumnSpacing="12" Padding="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" MinWidth="70" />
                                    <ColumnDefinition Width="Auto" MinWidth="96" />
                                    <ColumnDefinition Width="Auto" MinWidth="132" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{x:Bind MatchImage}"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Text="{x:Bind TriggerText}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                           Text="{x:Bind ActionSummary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                           Text="{x:Bind Precedence}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ToggleSwitch Grid.Column="5" VerticalAlignment="Center"
                                              MinWidth="0"
                                              AutomationProperties.Name="Enable rule"
                                              IsOn="{x:Bind Enabled}"
                                              OnContent="" OffContent=""
                                              Toggled="EnabledToggle_Toggled" />

                                <!-- Per-row actions -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button AutomationProperties.Name="Preview impact"
                                            ToolTipService.ToolTip="Preview impact"
                                            Background="Transparent" BorderThickness="0"
                                            Click="PreviewRule_Click">
                                        <FontIcon Glyph="&#xE7B3;" FontSize="15" />
                                    </Button>
                                    <Button AutomationProperties.Name="Edit rule"
                                            ToolTipService.ToolTip="Edit"
                                            Background="Transparent" BorderThickness="0"
                                            Click="EditRule_Click">
                                        <FontIcon Glyph="&#xE70F;" FontSize="15" />
                                    </Button>
                                    <Button AutomationProperties.Name="Delete rule"
                                            ToolTipService.ToolTip="Delete"
                                            Background="Transparent" BorderThickness="0"
                                            Click="DeleteRule_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Active interventions (transparency, PRD §9.7.3) -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12"
                MaxHeight="240">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Active interventions"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.InterventionsStatus, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!-- Unavailable note -->
                <TextBlock Grid.Row="2" VerticalAlignment="Top" Margin="0,4,0,0"
                           Visibility="{x:Bind ViewModel.InterventionsUnavailable, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="The connected service can't report active interventions yet." />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.InterventionsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Interventions, Mode=OneWay}"
                                  AutomationProperties.Name="Active interventions list">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InterventionRowViewModel">
                                <Grid ColumnSpacing="12" Padding="0,5"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" MinWidth="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ImageName}" />
                                        <TextBlock Text="{x:Bind PidText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{x:Bind Applied}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{x:Bind RuleName}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Text="{x:Bind Since}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
