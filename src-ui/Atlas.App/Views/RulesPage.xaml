<Page
    x:Class="Atlas.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border x:Name="DemoBadge" Visibility="Collapsed"
                            Style="{StaticResource AtlasStatusPillStyle}">
                        <TextBlock Text="DEMO DATA"
                                   Style="{StaticResource AtlasSectionLabelStyle}"
                                   Foreground="{ThemeResource AtlasAmberBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Rules" Style="{StaticResource AtlasPageHeadingStyle}" />
                <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                           Text="Performance &amp; optimization rules applied to matching processes. Nothing applies until you save - every change is reversible." />
            </StackPanel>
            <Button x:Name="NewRuleButton" Grid.Column="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    AutomationProperties.Name="New rule"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewRule_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New rule" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status line -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Rules table / states -->
        <Grid Grid.Row="2">
            <!-- Unavailable -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Rules unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           Text="The connected service is too old to manage rules. Update the Atlas service to use the rules engine." />
            </StackPanel>

            <!-- Empty -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE9F5;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No rules yet"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           Text="Create a rule to steer a process's priority, cores, or efficiency mode. You can always preview the impact before it applies." />
            </StackPanel>

            <Grid Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Grid Grid.Row="0" Padding="16,0,16,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" MinWidth="70" />
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="Auto" MinWidth="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="MATCH" Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="WHEN" Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="ACTION" Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="PREC" Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="5" Text="ENABLED" Style="{StaticResource AtlasColumnHeaderStyle}" />
                </Grid>

                <!-- Rows -->
                <Border Grid.Row="1" Style="{StaticResource AtlasPanelFlatStyle}">
                    <ListView AutomationProperties.Name="Rules table"
                              ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuleRowViewModel">
                                <Grid ColumnSpacing="12" Padding="8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" MinWidth="70" />
                                        <ColumnDefinition Width="Auto" MinWidth="96" />
                                        <ColumnDefinition Width="Auto" MinWidth="132" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{x:Bind MatchImage}"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{x:Bind TriggerText}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               Text="{x:Bind ActionSummary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                               Text="{x:Bind Precedence}"
                                               Style="{StaticResource AtlasMonoMutedStyle}" />
                                    <ToggleSwitch Grid.Column="5" VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Enable rule"
                                                  IsOn="{x:Bind Enabled}"
                                                  OnContent="" OffContent=""
                                                  Toggled="EnabledToggle_Toggled" />

                                    <!-- Per-row actions -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center">
                                        <Button AutomationProperties.Name="Preview impact"
                                                ToolTipService.ToolTip="Preview impact"
                                                Background="Transparent" BorderThickness="0"
                                                Click="PreviewRule_Click">
                                            <FontIcon Glyph="&#xE7B3;" FontSize="15" />
                                        </Button>
                                        <Button AutomationProperties.Name="Edit rule"
                                                ToolTipService.ToolTip="Edit"
                                                Background="Transparent" BorderThickness="0"
                                                Click="EditRule_Click">
                                            <FontIcon Glyph="&#xE70F;" FontSize="15" />
                                        </Button>
                                        <Button AutomationProperties.Name="Delete rule"
                                                ToolTipService.ToolTip="Delete"
                                                Background="Transparent" BorderThickness="0"
                                                Click="DeleteRule_Click">
                                            <FontIcon Glyph="&#xE74D;" FontSize="15" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>

        <!-- Dynamic responsiveness protection (R3, PRD §9.7.3). A CPU watchdog
             that, when explicitly enabled, TEMPORARILY eases back a background
             app monopolising the CPU and auto-restores it - never the app you're
             using or system-critical processes. The whole point of this card is
             the safety framing: temporary, reversible, off by default. -->
        <Border Grid.Row="3" Style="{StaticResource AtlasPanelStyle}">
            <StackPanel Spacing="10">
                <!-- Header -->
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="14"
                                  Foreground="{ThemeResource AtlasCyanBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="DYNAMIC RESPONSIVENESS PROTECTION"
                                   Style="{StaticResource AtlasSectionLabelStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource AtlasStatusPillStyle}"
                            Visibility="{x:Bind ViewModel.DynProtectionEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ON"
                                   Style="{StaticResource AtlasSectionLabelStyle}"
                                   Foreground="{ThemeResource AtlasGreenBrush}" />
                    </Border>
                </Grid>

                <!-- Unavailable state: keep the rest of the page working -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.DynProtectionSupported, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Dynamic protection is unavailable - the connected service is too old. The rest of this page still works; update the Atlas service to use it."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Supported: explanation + master toggle + config -->
                <StackPanel Spacing="10"
                            Visibility="{x:Bind ViewModel.DynProtectionSupported, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                    <!-- Plain-language, honest explanation (the whole point) -->
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="When on, Atlas temporarily eases back a background app that's monopolizing the CPU, and restores it automatically. It never touches the app you're using or system-critical processes." />

                    <!-- Master toggle (off by default) -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Protect responsiveness" />
                            <TextBlock Text="Off by default. Turning this on is your consent; you can turn it off any time."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                      MinWidth="0"
                                      AutomationProperties.Name="Enable dynamic responsiveness protection"
                                      IsOn="{x:Bind ViewModel.DynProtectionEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                    </Grid>

                    <!-- Config controls, shown only when enabled -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.DynProtectionEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="20" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- CPU threshold -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="CPU THRESHOLD (%)"
                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                <NumberBox AutomationProperties.Name="CPU threshold percent"
                                           Value="{x:Bind ViewModel.DynThresholdPercent, Mode=TwoWay}"
                                           Minimum="{x:Bind ViewModel.ThresholdMin}"
                                           Maximum="{x:Bind ViewModel.ThresholdMax}"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1" LargeChange="5"
                                           ValidationMode="InvalidInputOverwritten" />
                                <TextBlock Text="Only a background app above this share of total CPU is ever a candidate."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Sustain duration -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="SUSTAIN (SECONDS)"
                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                <NumberBox AutomationProperties.Name="Sustain duration in seconds"
                                           Value="{x:Bind ViewModel.DynSustainSeconds, Mode=TwoWay}"
                                           Minimum="{x:Bind ViewModel.SustainMin}"
                                           Maximum="{x:Bind ViewModel.SustainMax}"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="5" LargeChange="30"
                                           ValidationMode="InvalidInputOverwritten" />
                                <TextBlock Text="It must stay above the threshold this long first - brief spikes are ignored."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Max intervention duration -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                <TextBlock Text="MAX EASE-BACK (SECONDS)"
                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                <NumberBox AutomationProperties.Name="Maximum intervention duration in seconds"
                                           Value="{x:Bind ViewModel.DynMaxSeconds, Mode=TwoWay}"
                                           Minimum="{x:Bind ViewModel.MaxInterventionMin}"
                                           Maximum="{x:Bind ViewModel.MaxInterventionMax}"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="30" LargeChange="60"
                                           ValidationMode="InvalidInputOverwritten" />
                                <TextBlock Text="A hard cap - Atlas always restores the app within this time, whatever happens."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Live summary of what Save will do -->
                    <TextBlock Text="{x:Bind ViewModel.DynProtectionSummary, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Note pointing at the transparency surface below -->
                    <TextBlock Text="Any app Atlas is currently easing back appears in Active interventions below, with the reason why."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Save + result -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="SaveDynProtectionButton"
                                AutomationProperties.Name="Save dynamic protection settings"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Save"
                                Click="SaveDynProtection_Click" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsSavingDynProtection, Mode=OneWay}"
                                      Width="16" Height="16" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.DynProtectionStatus, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Active interventions (transparency, PRD §9.7.3). Live changes Atlas is
             currently applying - styled amber/elevated. Each is temporary and
             auto-reverting; the row shows what was applied, the rule, and how long. -->
        <Border Grid.Row="4" Style="{StaticResource AtlasPanelStyle}"
                BorderBrush="{ThemeResource AtlasAmberBrush}"
                MaxHeight="240">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14"
                              Foreground="{ThemeResource AtlasAmberBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="ACTIVE INTERVENTIONS"
                               Style="{StaticResource AtlasSectionLabelStyle}"
                               Foreground="{ThemeResource AtlasAmberBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.InterventionsStatus, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!-- Unavailable note -->
                <TextBlock Grid.Row="2" VerticalAlignment="Top" Margin="0,4,0,0"
                           Visibility="{x:Bind ViewModel.InterventionsUnavailable, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="The connected service can't report active interventions yet." />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.InterventionsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Interventions, Mode=OneWay}"
                                  AutomationProperties.Name="Active interventions list">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InterventionRowViewModel">
                                <Grid ColumnSpacing="12" Padding="0,6"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" MinWidth="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ImageName}"
                                                   Style="{StaticResource AtlasMonoStyle}" />
                                        <TextBlock Text="{x:Bind PidText}"
                                                   Style="{StaticResource AtlasMonoMutedStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{x:Bind Applied}"
                                               Style="{StaticResource AtlasMonoStyle}"
                                               Foreground="{ThemeResource AtlasAmberBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{x:Bind RuleName}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Text="{x:Bind Since}"
                                               Style="{StaticResource AtlasMonoMutedStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
