<Page
    x:Class="Atlas.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:controls="using:Atlas.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot" Padding="12" RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="FilterBox.(Grid.Row)" Value="1" />
                        <Setter Target="FilterBox.(Grid.Column)" Value="0" />
                        <Setter Target="FilterBox.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="20" />
                        <Setter Target="FilterBox.(Grid.Row)" Value="0" />
                        <Setter Target="FilterBox.(Grid.Column)" Value="1" />
                        <Setter Target="FilterBox.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="24" />
                        <Setter Target="ConnectionsCompactTable.Visibility" Value="Collapsed" />
                        <Setter Target="ConnectionsWideTable.Visibility" Value="Visible" />
                        <Setter Target="PortsCompactTable.Visibility" Value="Collapsed" />
                        <Setter Target="PortsWideTable.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Network" Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Active connections and listening ports, by owning process. Read-only inventory." />
        </StackPanel>

        <!-- ===== Sub-view toggle + filter ===== -->
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0"
                        VerticalAlignment="Center">
                <RadioButton Content="Connections"
                             AutomationProperties.Name="Show active connections"
                             GroupName="NetView"
                             IsChecked="{x:Bind ViewModel.ShowConnections, Mode=OneWay}"
                             Checked="Connections_Checked" />
                <RadioButton Content="Listening ports"
                             AutomationProperties.Name="Show listening ports"
                             GroupName="NetView" Margin="12,0,0,0"
                             IsChecked="{x:Bind ViewModel.ShowListening, Mode=OneWay}"
                             Checked="Listening_Checked" />
            </StackPanel>

            <TextBox x:Name="FilterBox" Grid.Column="1"
                     AutomationProperties.Name="Filter network rows"
                     PlaceholderText="Filter by app, address, domain, state…"
                     Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- ===== Status line + read-only note ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="· READ-ONLY" />
        </StackPanel>

        <!-- ===== Refresh ===== -->
        <Button Grid.Row="3" HorizontalAlignment="Left"
                Content="Refresh"
                Style="{StaticResource AtlasGhostButtonStyle}"
                AutomationProperties.Name="Refresh network list"
                Click="Refresh_Click" />

        <!-- ===== Table / empty / unavailable ===== -->
        <Grid Grid.Row="4">
            <!-- Unavailable placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Network unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}"
                           Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           MaxWidth="420" />
            </StackPanel>

            <!-- Empty placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Nothing to show here"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
            </StackPanel>

            <!-- Connections table -->
            <Grid Visibility="{x:Bind ViewModel.ShowConnections, Mode=OneWay}">
                <Grid x:Name="ConnectionsWideTable" Visibility="Collapsed">
                    <Grid Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <!-- Column header -->
                    <Grid Grid.Row="0" Padding="12,0,12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="Auto" MinWidth="60" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="APP"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="PROTO"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="LOCAL"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="REMOTE"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="DOMAIN"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="STATE"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Grid>

                        <ListView Grid.Row="1"
                              AutomationProperties.Name="Connections table"
                              ItemContainerStyle="{StaticResource AtlasRowContainerStyle}"
                              ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="Auto" MinWidth="60" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <controls:AppIcon ProcessId="{x:Bind Pid}" Width="20" Height="20"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Process}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               Text="{x:Bind Protocol}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoStyle}"
                                               Text="{x:Bind LocalEndpoint}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoStyle}"
                                               Text="{x:Bind RemoteEndpoint}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               Text="{x:Bind Domain}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{x:Bind StateToken, Converter={StaticResource MonitorTokenToBrush}}" />
                                        <TextBlock Text="{x:Bind StateText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
                <ListView x:Name="ConnectionsCompactTable"
                          AutomationProperties.Name="Connections list"
                          ItemContainerStyle="{StaticResource AtlasRowContainerStyle}"
                          ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                          SelectionMode="Single"
                          Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionItem">
                            <StackPanel Spacing="5">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:AppIcon ProcessId="{x:Bind Pid}" Width="20" Height="20"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Text="{x:Bind Process}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind StateToken, Converter={StaticResource MonitorTokenToBrush}}" />
                                        <TextBlock Text="{x:Bind StateText}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource AtlasMonoStyle}"
                                           Text="{x:Bind LocalEndpoint}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind RemoteEndpoint}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Style="{StaticResource AtlasMonoMutedStyle}" Text="{x:Bind Protocol}" />
                                    <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                                               Text="{x:Bind Domain}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Listening ports table -->
            <Grid Visibility="{x:Bind ViewModel.ShowListening, Mode=OneWay}">
                <Grid x:Name="PortsWideTable" Visibility="Collapsed">
                    <Grid Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,0,12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" MinWidth="60" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="APP"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="PROTO"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="BIND ENDPOINT"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="FAMILY"
                                   Style="{StaticResource AtlasColumnHeaderStyle}" />
                    </Grid>

                        <ListView Grid.Row="1"
                              AutomationProperties.Name="Listening ports table"
                              ItemContainerStyle="{StaticResource AtlasRowContainerStyle}"
                              ItemsSource="{x:Bind ViewModel.Ports, Mode=OneWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ListeningPortItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" MinWidth="60" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <controls:AppIcon ProcessId="{x:Bind Pid}" Width="20" Height="20"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Text="{x:Bind Process}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               Text="{x:Bind Protocol}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoStyle}"
                                               Text="{x:Bind Endpoint}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               Text="{x:Bind Family}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
                <ListView x:Name="PortsCompactTable"
                          AutomationProperties.Name="Listening ports list"
                          ItemContainerStyle="{StaticResource AtlasRowContainerStyle}"
                          ItemsSource="{x:Bind ViewModel.Ports, Mode=OneWay}"
                          SelectionMode="Single"
                          Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ListeningPortItem">
                            <StackPanel Spacing="5">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:AppIcon ProcessId="{x:Bind Pid}" Width="20" Height="20"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Text="{x:Bind Process}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               Text="{x:Bind Protocol}" />
                                </Grid>
                                <TextBlock Style="{StaticResource AtlasMonoStyle}"
                                           Text="{x:Bind Endpoint}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind Family}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
