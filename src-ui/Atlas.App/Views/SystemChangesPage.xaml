<Page
    x:Class="Atlas.App.Views.SystemChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="System Changes" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="What changed on this PC — read-only, factual, newest first" />
        </StackPanel>

        <!-- Controls: window + kind filter + text filter + refresh -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      AutomationProperties.Name="Time window for changes"
                      MinWidth="150"
                      ItemsSource="{x:Bind ViewModel.Windows}"
                      SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />

            <ComboBox Grid.Column="1"
                      AutomationProperties.Name="Filter changes by kind"
                      MinWidth="160"
                      ItemsSource="{x:Bind ViewModel.KindFilters}"
                      SelectedItem="{x:Bind ViewModel.SelectedKindFilter, Mode=TwoWay}" />

            <TextBox Grid.Column="2"
                     AutomationProperties.Name="Filter changes by text"
                     PlaceholderText="Filter by app, publisher, detail…"
                     Text="{x:Bind ViewModel.TextFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="3"
                    x:Name="RefreshButton"
                    AutomationProperties.Name="Refresh changes"
                    Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status line -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Body: timeline list (left) + detail pane (right) -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Timeline list / empty / unavailable -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="2">
                <Grid>
                    <!-- Unavailable (server too old) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="24" MaxWidth="420"
                                Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="System changes unavailable"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalTextAlignment="Center" />
                        <TextBlock Text="The connected service is too old to record system changes. Update the service to see what changed."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" HorizontalTextAlignment="Center" />
                    </StackPanel>

                    <!-- Empty (calm — nothing changed is fine) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="24" MaxWidth="420"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="28"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No changes here"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalTextAlignment="Center" />
                        <TextBlock Text="Nothing was installed, updated, or reconfigured in this window."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" HorizontalTextAlignment="Center" />
                    </StackPanel>

                    <!-- The timeline -->
                    <ListView AutomationProperties.Name="Recorded system changes"
                              ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedChange, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,10" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SystemChangeRowViewModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Calm category glyph -->
                                    <FontIcon Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Glyph="{x:Bind KindGlyph}" FontSize="18"
                                              Foreground="{x:Bind CategoryToken, Converter={StaticResource ChangeCategoryToBrush}}" />

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind KindLabel}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsReversible}"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="2" Padding="6,1">
                                                <TextBlock Text="{x:Bind ReversibleLabel}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Subject}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind DetailText}"
                                                   Visibility="{x:Bind HasDetail}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Provenance}"
                                                   Visibility="{x:Bind HasProvenance}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Top"
                                               Text="{x:Bind TimeText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Detail pane -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="2">
                <Grid>
                    <!-- Placeholder when nothing selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="20" MaxWidth="280"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <FontIcon Glyph="&#xE946;" FontSize="24"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Select a change to see its full detail"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" HorizontalTextAlignment="Center" />
                    </StackPanel>

                    <!-- Full detail -->
                    <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  VerticalScrollBarVisibility="Auto" Padding="18">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon VerticalAlignment="Center"
                                              Glyph="{x:Bind ViewModel.SelectedChange.KindGlyph, Mode=OneWay}" FontSize="18"
                                              Foreground="{x:Bind ViewModel.SelectedChange.CategoryToken, Mode=OneWay, Converter={StaticResource ChangeCategoryToBrush}}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedChange.KindLabel, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.Subject, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.AbsoluteTimeText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Before -> after detail -->
                            <StackPanel Spacing="4"
                                        Visibility="{x:Bind ViewModel.SelectedChange.HasDetail, Mode=OneWay}">
                                <TextBlock Text="What changed"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.DetailText, Mode=OneWay}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Publisher -->
                            <StackPanel Spacing="4"
                                        Visibility="{x:Bind ViewModel.SelectedChange.HasPublisher, Mode=OneWay}">
                                <TextBlock Text="Publisher"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.Publisher, Mode=OneWay}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Responsible -->
                            <StackPanel Spacing="4"
                                        Visibility="{x:Bind ViewModel.SelectedChange.HasResponsible, Mode=OneWay}">
                                <TextBlock Text="Applied by"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.Responsible, Mode=OneWay}"
                                           FontFamily="Consolas" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Reversibility note (informational) -->
                            <Border Visibility="{x:Bind ViewModel.SelectedChange.IsReversible, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="2" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              VerticalAlignment="Top" />
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Atlas knows a way to reverse this change. (Informational — no action is taken here.)" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
