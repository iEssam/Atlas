<Page
    x:Class="Atlas.App.Views.SystemChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot" Padding="12" RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="WindowPicker.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="KindPicker.(Grid.Row)" Value="1" />
                        <Setter Target="KindPicker.(Grid.Column)" Value="0" />
                        <Setter Target="TextFilterBox.(Grid.Row)" Value="2" />
                        <Setter Target="TextFilterBox.(Grid.Column)" Value="0" />
                        <Setter Target="TextFilterBox.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="RefreshButton.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshButton.(Grid.Column)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="20" />
                        <Setter Target="TimelineRow.Height" Value="3*" />
                        <Setter Target="ChangeDetailRow.Height" Value="2*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="24" />
                        <Setter Target="WindowPicker.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="KindPicker.(Grid.Row)" Value="0" />
                        <Setter Target="KindPicker.(Grid.Column)" Value="1" />
                        <Setter Target="TextFilterBox.(Grid.Row)" Value="0" />
                        <Setter Target="TextFilterBox.(Grid.Column)" Value="2" />
                        <Setter Target="TextFilterBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RefreshButton.(Grid.Row)" Value="0" />
                        <Setter Target="RefreshButton.(Grid.Column)" Value="3" />
                        <Setter Target="TimelineColumn.Width" Value="*" />
                        <Setter Target="ChangeDetailColumn.Width" Value="360" />
                        <Setter Target="TimelineRow.Height" Value="*" />
                        <Setter Target="ChangeDetailRow.Height" Value="0" />
                        <Setter Target="ChangeDetailPanel.(Grid.Row)" Value="0" />
                        <Setter Target="ChangeDetailPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="System Changes" Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="What changed on this PC - read-only, factual, newest first." />
        </StackPanel>

        <!-- Controls: window + kind filter + text filter + refresh -->
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="WindowPicker" Grid.Column="0"
                      AutomationProperties.Name="Time window for changes"
                      MinWidth="150"
                      ItemsSource="{x:Bind ViewModel.Windows}"
                      SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />

            <ComboBox x:Name="KindPicker" Grid.Column="1"
                      AutomationProperties.Name="Filter changes by kind"
                      MinWidth="160"
                      ItemsSource="{x:Bind ViewModel.KindFilters}"
                      SelectedItem="{x:Bind ViewModel.SelectedKindFilter, Mode=TwoWay}" />

            <TextBox x:Name="TextFilterBox" Grid.Column="2"
                     AutomationProperties.Name="Filter changes by text"
                     PlaceholderText="Filter by app, publisher, detail…"
                     Text="{x:Bind ViewModel.TextFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="3"
                    x:Name="RefreshButton"
                    Style="{StaticResource AtlasGhostButtonStyle}"
                    AutomationProperties.Name="Refresh changes"
                    Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status line -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Body: timeline list (left) + detail pane (right) -->
        <Grid Grid.Row="3" ColumnSpacing="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TimelineRow" Height="3*" />
                <RowDefinition x:Name="ChangeDetailRow" Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TimelineColumn" Width="*" />
                <ColumnDefinition x:Name="ChangeDetailColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Timeline list / empty / unavailable -->
            <Border Grid.Column="0" Style="{StaticResource AtlasPanelFlatStyle}">
                <Grid>
                    <!-- Unavailable (server too old) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="24" MaxWidth="420"
                                Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                  Foreground="{ThemeResource AtlasMutedBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="System changes unavailable"
                                   Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                        <TextBlock Text="The connected service is too old to record system changes. Update the service to see what changed."
                                   Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                    </StackPanel>

                    <!-- Empty (calm - nothing changed is fine) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="24" MaxWidth="420"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="28"
                                  Foreground="{ThemeResource AtlasGreenBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No changes here"
                                   Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                        <TextBlock Text="Nothing was installed, updated, or reconfigured in this window."
                                   Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                    </StackPanel>

                    <!-- The timeline -->
                    <ListView AutomationProperties.Name="Recorded system changes"
                              ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedChange, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SystemChangeRowViewModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Calm category glyph -->
                                    <FontIcon Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Glyph="{x:Bind KindGlyph}" FontSize="18"
                                              Foreground="{x:Bind CategoryToken, Converter={StaticResource ChangeCategoryToBrush}}" />

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind KindLabel}"
                                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                                       FontSize="11.5" />
                                            <Border VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsReversible}"
                                                    Style="{StaticResource AtlasStatusPillStyle}"
                                                    Padding="6,1">
                                                <TextBlock Text="{x:Bind ReversibleLabel}"
                                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Subject}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind DetailText}"
                                                   Visibility="{x:Bind HasDetail}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Provenance}"
                                                   Visibility="{x:Bind HasProvenance}"
                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Top"
                                               Text="{x:Bind TimeText}"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               FontSize="11.5" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Detail pane -->
            <Border x:Name="ChangeDetailPanel" Grid.Row="1" Grid.Column="0" Style="{StaticResource AtlasPanelFlatStyle}">
                <Grid>
                    <!-- Placeholder when nothing selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="20" MaxWidth="280"
                                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <FontIcon Glyph="&#xE946;" FontSize="24"
                                  Foreground="{ThemeResource AtlasMutedBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Select a change to see its full detail"
                                   Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                    </StackPanel>

                    <!-- Full detail -->
                    <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  VerticalScrollBarVisibility="Auto" Padding="18">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon VerticalAlignment="Center"
                                              Glyph="{x:Bind ViewModel.SelectedChange.KindGlyph, Mode=OneWay}" FontSize="18"
                                              Foreground="{x:Bind ViewModel.SelectedChange.CategoryToken, Mode=OneWay, Converter={StaticResource ChangeCategoryToBrush}}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedChange.KindLabel, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               FontSize="11.5" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.Subject, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.AbsoluteTimeText, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoMutedStyle}" />
                            </StackPanel>

                            <!-- Before -> after detail -->
                            <StackPanel Spacing="4"
                                        Visibility="{x:Bind ViewModel.SelectedChange.HasDetail, Mode=OneWay}">
                                <TextBlock Text="WHAT CHANGED"
                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.DetailText, Mode=OneWay}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Publisher -->
                            <StackPanel Spacing="4"
                                        Visibility="{x:Bind ViewModel.SelectedChange.HasPublisher, Mode=OneWay}">
                                <TextBlock Text="PUBLISHER"
                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.Publisher, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoStyle}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Responsible -->
                            <StackPanel Spacing="4"
                                        Visibility="{x:Bind ViewModel.SelectedChange.HasResponsible, Mode=OneWay}">
                                <TextBlock Text="APPLIED BY"
                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChange.Responsible, Mode=OneWay}"
                                           Style="{StaticResource AtlasMonoStyle}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Reversibility note (informational) -->
                            <Border Visibility="{x:Bind ViewModel.SelectedChange.IsReversible, Mode=OneWay}"
                                    Style="{StaticResource AtlasInsetStyle}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="14"
                                              Foreground="{ThemeResource AtlasMutedBrush}"
                                              VerticalAlignment="Top" />
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource AtlasMonoMutedStyle}"
                                               FontSize="11.5"
                                               Text="Atlas knows a way to reverse this change. (Informational - no action is taken here.)" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
