<Page
    x:Class="Atlas.App.Views.ScheduledTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Scheduled Tasks" Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Windows Task Scheduler entries with last / next run and last result. Read-only inventory." />
        </StackPanel>

        <!-- ===== Filter ===== -->
        <TextBox Grid.Row="1"
                 AutomationProperties.Name="Filter scheduled tasks by name or path"
                 PlaceholderText="Filter by name or path…"
                 Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- ===== Status line + read-only note ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       ToolTipService.ToolTip="Enabling, disabling and running tasks is coming soon."
                       Text="· READ-ONLY" />
        </StackPanel>

        <!-- ===== Table / empty / unavailable ===== -->
        <Grid Grid.Row="3">
            <!-- Unavailable placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Scheduled tasks unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Text="The connected service is too old to list scheduled tasks."
                           Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           MaxWidth="400" />
            </StackPanel>

            <!-- Empty placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No tasks match"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
            </StackPanel>

            <Grid Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column header -->
                <Grid Grid.Row="0" Padding="12,0,12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="Auto" MinWidth="80" />
                        <ColumnDefinition Width="Auto" MinWidth="90" />
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NAME"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="FOLDER"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="ENABLED"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="LAST RUN"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="NEXT RUN"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="5" Text="LAST RESULT"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                </Grid>

                <!-- Virtualized rows -->
                <ListView Grid.Row="1"
                          AutomationProperties.Name="Scheduled tasks table"
                          ItemContainerStyle="{StaticResource AtlasRowContainerStyle}"
                          ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScheduledTaskItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind Folder}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Text="{x:Bind EnabledText}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind LastRunText}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind NextRunText}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{x:Bind LastResultToken, Converter={StaticResource MonitorTokenToBrush}}" />
                                    <TextBlock Text="{x:Bind LastResultText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ===== Detail pane for the selected task ===== -->
        <Border Grid.Row="4"
                Style="{StaticResource AtlasPanelStyle}"
                Margin="0,4,0,0"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Text="SELECTED TASK" Style="{StaticResource AtlasSectionLabelStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedTask.Name, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedTask.Path, Mode=OneWay}"
                           Style="{StaticResource AtlasMonoMutedStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="ACTION" Style="{StaticResource AtlasSectionLabelStyle}"
                           Margin="0,4,0,0" />
                <Border Style="{StaticResource AtlasInsetStyle}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedTask.ActionText, Mode=OneWay}"
                               Style="{StaticResource AtlasMonoStyle}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </Border>

                <TextBlock Text="TRIGGERS" Style="{StaticResource AtlasSectionLabelStyle}"
                           Margin="0,4,0,0" />
                <TextBlock Text="{x:Bind ViewModel.SelectedTask.TriggersText, Mode=OneWay}"
                           TextWrapping="Wrap" />

                <TextBlock Text="AUTHOR" Style="{StaticResource AtlasSectionLabelStyle}"
                           Margin="0,4,0,0" />
                <TextBlock Text="{x:Bind ViewModel.SelectedTask.AuthorText, Mode=OneWay}" />

                <!-- Behaviour flags -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Border Style="{StaticResource AtlasStatusPillStyle}">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTask.RunLevelText, Mode=OneWay}"
                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                   FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource AtlasStatusPillStyle}">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTask.IdleText, Mode=OneWay}"
                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                   FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource AtlasStatusPillStyle}">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTask.WakeText, Mode=OneWay}"
                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
