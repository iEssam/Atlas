<ContentDialog
    x:Class="Atlas.App.Views.PrivacyAlertEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="14" MinWidth="440" MaxWidth="520" Margin="0,4,0,0">

            <!-- What this is -->
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Atlas will note it in your alerts when an app uses a capability the way you describe here. This only tells you - it never blocks the app." />

            <!-- Name -->
            <StackPanel Spacing="6">
                <TextBlock Text="ALERT NAME" Style="{StaticResource AtlasSectionLabelStyle}" />
                <TextBox x:Name="NameBox"
                         AutomationProperties.Name="Alert name"
                         PlaceholderText="e.g. Camera in the background" />
            </StackPanel>

            <!-- Capability -->
            <StackPanel Spacing="6">
                <TextBlock Text="CAPABILITY TO WATCH" Style="{StaticResource AtlasSectionLabelStyle}" />
                <ComboBox x:Name="CapabilityBox"
                          AutomationProperties.Name="Capability to watch"
                          HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="All (camera, microphone, location)" Tag="all" />
                    <ComboBoxItem Content="Camera" Tag="camera" />
                    <ComboBoxItem Content="Microphone" Tag="mic" />
                    <ComboBoxItem Content="Location" Tag="location" />
                </ComboBox>
            </StackPanel>

            <!-- Condition -->
            <StackPanel Spacing="6">
                <TextBlock Text="TELL ME WHEN IT'S USED" Style="{StaticResource AtlasSectionLabelStyle}" />
                <ComboBox x:Name="ConditionBox"
                          AutomationProperties.Name="When to alert"
                          HorizontalAlignment="Stretch" SelectedIndex="0"
                          SelectionChanged="ConditionBox_SelectionChanged">
                    <ComboBoxItem Content="Any use" Tag="anyuse" />
                    <ComboBoxItem Content="Background use (app isn't in focus)" Tag="background" />
                    <ComboBoxItem Content="While the screen is locked" Tag="locked" />
                    <ComboBoxItem Content="An unknown or unsigned app" Tag="unknown" />
                    <ComboBoxItem Content="Active longer than…" Tag="longer" />
                </ComboBox>
            </StackPanel>

            <!-- Threshold (only for "longer than") -->
            <StackPanel x:Name="ThresholdPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="LONGER THAN (SECONDS)" Style="{StaticResource AtlasSectionLabelStyle}" />
                <NumberBox x:Name="ThresholdBox"
                           AutomationProperties.Name="Threshold in seconds"
                           Value="60" SpinButtonPlacementMode="Inline"
                           Minimum="1" Maximum="86400" SmallChange="10" LargeChange="60" />
                <TextBlock Text="Alert when a single session stays active longer than this many seconds."
                           Style="{StaticResource AtlasMonoMutedStyle}"
                           FontSize="11.5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Enabled -->
            <ToggleSwitch x:Name="EnabledSwitch"
                          AutomationProperties.Name="Enable this alert now"
                          Header="Enable now"
                          IsOn="True"
                          OffContent="Saved but not watching"
                          OnContent="Watching for this" />

            <!-- Validation -->
            <InfoBar x:Name="ValidationBar" IsOpen="False" IsClosable="False"
                     Severity="Error" Title="Check the alert" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
