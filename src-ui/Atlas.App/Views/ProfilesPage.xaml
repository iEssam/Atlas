<Page
    x:Class="Atlas.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="CONTROL / PROFILES" Style="{StaticResource AtlasEyebrowStyle}"
                               VerticalAlignment="Center" />
                    <Border x:Name="DemoBadge" Visibility="Collapsed"
                            Style="{StaticResource AtlasStatusPillStyle}"
                            Background="{ThemeResource AtlasAmberTintBrush}"
                            BorderBrush="{ThemeResource AtlasAmberBrush}">
                        <TextBlock Text="DEMO DATA"
                                   Style="{StaticResource AtlasSectionLabelStyle}"
                                   Foreground="{ThemeResource AtlasAmberBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Profiles" Style="{StaticResource AtlasPageHeadingStyle}" />
                <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                           Text="Activatable bundles of rules with an optional power mode. Activating one turns on its member rules together." />
            </StackPanel>
            <Button x:Name="NewProfileButton" Grid.Column="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    AutomationProperties.Name="New profile"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewProfile_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New profile" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- Profiles / states -->
        <Grid Grid.Row="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Profiles unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           Text="The connected service is too old to manage profiles. Update the Atlas service to use them." />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE748;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No profiles yet"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Style="{StaticResource AtlasEmptyStateBodyStyle}"
                           Text="Bundle a set of rules into a profile - like “Gaming” or “Battery saver” - and switch them all on with one toggle." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                              AutomationProperties.Name="Profiles list">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileRowViewModel">
                            <Border Margin="0,0,0,10"
                                    Style="{StaticResource AtlasPanelStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <Border Style="{StaticResource AtlasStatusPillStyle}"
                                                    Background="{ThemeResource AtlasGreenTintBrush}"
                                                    BorderBrush="{ThemeResource AtlasGreenBrush}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind Active, Mode=OneWay}">
                                                <TextBlock Text="ACTIVE"
                                                           Style="{StaticResource AtlasSectionLabelStyle}"
                                                           Foreground="{ThemeResource AtlasGreenBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind PowerModeLabel}"
                                                   Style="{StaticResource AtlasMonoMutedStyle}" />
                                        <TextBlock Text="{x:Bind MemberSummary}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Top">
                                        <ToggleSwitch VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Activate profile"
                                                      IsOn="{x:Bind Active, Mode=OneWay}"
                                                      OnContent="" OffContent=""
                                                      Toggled="ActiveToggle_Toggled" />
                                        <Button AutomationProperties.Name="Edit profile"
                                                ToolTipService.ToolTip="Edit"
                                                Background="Transparent" BorderThickness="0"
                                                Click="EditProfile_Click">
                                            <FontIcon Glyph="&#xE70F;" FontSize="15" />
                                        </Button>
                                        <Button AutomationProperties.Name="Delete profile"
                                                ToolTipService.ToolTip="Delete"
                                                Background="Transparent" BorderThickness="0"
                                                Click="DeleteProfile_Click">
                                            <FontIcon Glyph="&#xE74D;" FontSize="15" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
