<UserControl
    x:Class="Atlas.App.Views.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.OverviewName, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.HeaderText}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Tabs -->
        <TabView Grid.Row="1"
                 x:Name="Tabs"
                 IsAddTabButtonVisible="False"
                 CanReorderTabs="False"
                 CanDragTabs="False"
                 SelectionChanged="OnTabSelectionChanged">
            <TabView.TabItems>

                <!-- ============ OVERVIEW ============ -->
                <TabViewItem Header="Overview" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE946;" />
                    </TabViewItem.IconSource>
                    <Grid RowSpacing="12" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Button Click="OnRefreshOverview"
                                    AutomationProperties.Name="Refresh overview">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind ViewModel.OverviewLoading, Mode=OneWay}"
                                          Width="18" Height="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Limited-coverage note (honest, calm) -->
                        <InfoBar Grid.Row="1"
                                 IsOpen="{x:Bind ViewModel.OverviewIsLimited, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Partial coverage"
                                 Message="{x:Bind ViewModel.OverviewLimitedNote, Mode=OneWay}" />

                        <!-- Unavailable state -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.OverviewUnavailable, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.OverviewUnavailableText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="420"
                                       HorizontalTextAlignment="Center" />
                        </StackPanel>

                        <!-- Detail -->
                        <ScrollViewer Grid.Row="2"
                                      Visibility="{x:Bind ViewModel.OverviewHasData, Mode=OneWay}">
                            <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Left">

                                <!-- Signature + integrity badges -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="2" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{x:Bind ViewModel.OverviewSignatureToken, Mode=OneWay, Converter={StaticResource TrustTokenToBrush}}" />
                                            <TextBlock Text="{x:Bind ViewModel.OverviewSignature, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="2" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Integrity:"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.OverviewIntegrity, Mode=OneWay}" />
                                            <TextBlock Text="•"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.OverviewElevation, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Field rows -->
                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PID" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OverviewPid, Mode=OneWay}" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Parent PID" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OverviewParentPid, Mode=OneWay}" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Path" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.OverviewPath, Mode=OneWay}"
                                               TextWrapping="Wrap" FontFamily="Consolas" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Command line" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.OverviewCommandLine, Mode=OneWay}"
                                               TextWrapping="Wrap" FontFamily="Consolas" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Working dir" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.OverviewWorkingDir, Mode=OneWay}"
                                               TextWrapping="Wrap" FontFamily="Consolas" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="User" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.OverviewUser, Mode=OneWay}" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Architecture" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.OverviewArchitecture, Mode=OneWay}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Publisher" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.OverviewPublisher, Mode=OneWay}" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Package" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.OverviewPackage, Mode=OneWay}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="File version" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind ViewModel.OverviewFileVersion, Mode=OneWay}" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Product" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{x:Bind ViewModel.OverviewProductName, Mode=OneWay}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Started" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="{x:Bind ViewModel.OverviewStartTime, Mode=OneWay}" />

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Counts" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{x:Bind ViewModel.OverviewCounts, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabViewItem>

                <!-- ============ HANDLES ============ -->
                <TabViewItem Header="Handles" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE71D;" />
                    </TabViewItem.IconSource>
                    <Grid RowSpacing="10" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Button Click="OnRefreshHandles" AutomationProperties.Name="Refresh handles">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <TextBox Width="220"
                                     AutomationProperties.Name="Filter handles by type"
                                     PlaceholderText="Filter by type (e.g. File, Key)…"
                                     Text="{x:Bind ViewModel.HandleTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.HandlesLoading, Mode=OneWay}"
                                          Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.HandlesStatus, Mode=OneWay}" />
                        </StackPanel>

                        <InfoBar Grid.Row="1"
                                 IsOpen="{x:Bind ViewModel.HandlesNamesLimited, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Some names couldn't be resolved"
                                 Message="{x:Bind ViewModel.HandlesNamesLimitedNote, Mode=OneWay}" />

                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.HandlesUnavailable, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.HandlesUnavailableText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="420" HorizontalTextAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="3"
                              Visibility="{x:Bind ViewModel.HandlesUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,4,12,8" ColumnSpacing="12"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Handle" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Access" Style="{StaticResource ColHeaderStyle}" />
                            </Grid>
                            <ListView Grid.Row="1"
                                      AutomationProperties.Name="Handles table"
                                      ItemsSource="{x:Bind ViewModel.Handles, Mode=OneWay}"
                                      SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HandleRowItem">
                                        <Grid ColumnSpacing="12" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TypeText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind NameText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind NameText}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind HandleText}" VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind AccessText}" VerticalAlignment="Center"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind AccessText}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </TabViewItem>

                <!-- ============ MODULES ============ -->
                <TabViewItem Header="Modules" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE74C;" />
                    </TabViewItem.IconSource>
                    <Grid RowSpacing="10" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Button Click="OnRefreshModules" AutomationProperties.Name="Refresh modules">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind ViewModel.ModulesLoading, Mode=OneWay}"
                                          Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.ModulesStatus, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.ModulesUnavailable, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ModulesUnavailableText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="420" HorizontalTextAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Visibility="{x:Bind ViewModel.ModulesUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,4,12,8" ColumnSpacing="12"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Path" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Version" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Publisher" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="Signed" Style="{StaticResource ColHeaderStyle}" />
                            </Grid>
                            <ListView Grid.Row="1"
                                      AutomationProperties.Name="Modules table"
                                      ItemsSource="{x:Bind ViewModel.Modules, Mode=OneWay}"
                                      SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModuleRowItem">
                                        <Grid ColumnSpacing="12" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind NameText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind NameText}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind PathText}" VerticalAlignment="Center"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind PathText}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind VersionText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind PublisherText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PublisherText}" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{x:Bind SignedToken, Converter={StaticResource TrustTokenToBrush}}" />
                                                <TextBlock Text="{x:Bind SignedText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </TabViewItem>

                <!-- ============ THREADS ============ -->
                <TabViewItem Header="Threads" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE9D9;" />
                    </TabViewItem.IconSource>
                    <Grid RowSpacing="10" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Button Click="OnRefreshThreads" AutomationProperties.Name="Refresh threads">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind ViewModel.ThreadsLoading, Mode=OneWay}"
                                          Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.ThreadsStatus, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.ThreadsUnavailable, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ThreadsUnavailableText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="420" HorizontalTextAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Visibility="{x:Bind ViewModel.ThreadsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,4,12,8" ColumnSpacing="12"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TID" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Start address" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="State" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Wait reason" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="Priority" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="CPU" Style="{StaticResource ColHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="CPU time" Style="{StaticResource ColHeaderStyle}" />
                            </Grid>
                            <ListView Grid.Row="1"
                                      AutomationProperties.Name="Threads table"
                                      ItemsSource="{x:Bind ViewModel.Threads, Mode=OneWay}"
                                      SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThreadRowItem">
                                        <Grid ColumnSpacing="12" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TidText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind StartAddressText}" VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind StateText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind WaitReasonText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind PriorityText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind CpuText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind CpuTimeText}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </TabViewItem>

                <!-- ============ SECURITY ============ -->
                <TabViewItem Header="Security" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE72E;" />
                    </TabViewItem.IconSource>
                    <Grid RowSpacing="12" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Button Click="OnRefreshSecurity"
                                    AutomationProperties.Name="Refresh security details">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind ViewModel.SecurityLoading, Mode=OneWay}"
                                          Width="18" Height="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Limited-coverage note (honest, calm) -->
                        <InfoBar Grid.Row="1"
                                 IsOpen="{x:Bind ViewModel.SecurityIsLimited, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Partial coverage"
                                 Message="{x:Bind ViewModel.SecurityLimitedNote, Mode=OneWay}" />

                        <!-- Unavailable state -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.SecurityUnavailable, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SecurityUnavailableText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="420"
                                       HorizontalTextAlignment="Center" />
                        </StackPanel>

                        <!-- Detail -->
                        <ScrollViewer Grid.Row="2"
                                      Visibility="{x:Bind ViewModel.SecurityHasData, Mode=OneWay}">
                            <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Left">

                                <!-- ===== Signature ===== -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Signature" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="2" Padding="10,6"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{x:Bind ViewModel.SecuritySignatureToken, Mode=OneWay, Converter={StaticResource TrustTokenToBrush}}" />
                                            <TextBlock Text="{x:Bind ViewModel.SecuritySignature, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- No chain (unsigned / unavailable) -->
                                    <TextBlock Text="No certificate chain — this file is unsigned or the chain couldn’t be read."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind ViewModel.SecurityCertChainEmpty, Mode=OneWay}" />

                                    <!-- Certificate chain (leaf → root) -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CertChain, Mode=OneWay}"
                                                  AutomationProperties.Name="Certificate chain">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CertRowItem">
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="2"
                                                        Padding="12,10" Margin="0,0,0,8">
                                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subject"
                                                                   Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind SubjectText}"
                                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Issuer"
                                                                   Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind IssuerText}"
                                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Thumbprint"
                                                                   Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ThumbprintText}"
                                                                   FontFamily="Consolas" TextWrapping="Wrap"
                                                                   IsTextSelectionEnabled="True" />

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Validity"
                                                                   Style="{StaticResource FieldLabelStyle}" />
                                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <TextBlock Text="{x:Bind ValidUntilText}" VerticalAlignment="Center" />
                                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                    CornerRadius="2" Padding="8,2"
                                                                    Visibility="{x:Bind HasValidityNote}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                             Fill="{x:Bind ValidityToken, Converter={StaticResource SecurityTokenToBrush}}" />
                                                                    <TextBlock Text="{x:Bind ValidityNote}"
                                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ===== File ===== -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="File" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SHA-256" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SecuritySha256Grouped, Mode=OneWay}"
                                                   FontFamily="Consolas" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                        <Button Grid.Column="2" Click="OnCopySha256" VerticalAlignment="Top"
                                                AutomationProperties.Name="Copy SHA-256 hash"
                                                ToolTipService.ToolTip="Copy the full hash"
                                                Visibility="{x:Bind ViewModel.SecurityHasSha256, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- ===== Token ===== -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Token" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                    <Grid ColumnSpacing="16" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Integrity" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SecurityIntegrity, Mode=OneWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Elevation" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SecurityElevation, Mode=OneWay}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="App container" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SecurityAppContainer, Mode=OneWay}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="User SID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SecurityUserSid, Mode=OneWay}"
                                                   FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>

                                    <!-- Privileges -->
                                    <TextBlock Text="Privileges"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="No privileges reported."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.SecurityPrivilegesEmpty, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Privileges, Mode=OneWay}"
                                                  AutomationProperties.Name="Token privileges">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PrivilegeRowItem">
                                                <Grid ColumnSpacing="12" Padding="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind NameText}" VerticalAlignment="Center"
                                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind NameText}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind GlossText}" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{x:Bind HasGloss}"
                                                               ToolTipService.ToolTip="{x:Bind GlossText}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8"
                                                                 Fill="{x:Bind StateToken, Converter={StaticResource SecurityTokenToBrush}}" />
                                                        <TextBlock Text="{x:Bind StateText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Groups -->
                                    <TextBlock Text="Groups"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="No groups reported."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.SecurityGroupsEmpty, Mode=OneWay}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                                                   AutomationProperties.Name="Token groups">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="220" MinItemHeight="26"
                                                               MinColumnSpacing="8" MinRowSpacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="2" Padding="10,4">
                                                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <!-- Capabilities -->
                                    <TextBlock Text="Capabilities"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="No app-container capabilities reported."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.SecurityCapabilitiesEmpty, Mode=OneWay}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Capabilities, Mode=OneWay}"
                                                   AutomationProperties.Name="App-container capabilities">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="220" MinItemHeight="26"
                                                               MinColumnSpacing="8" MinRowSpacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="2" Padding="10,4">
                                                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- ===== Mitigations ===== -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Mitigations" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="No mitigation policies reported."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.SecurityMitigationsEmpty, Mode=OneWay}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mitigations, Mode=OneWay}"
                                                   AutomationProperties.Name="Process mitigation policies">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="180" MinItemHeight="28"
                                                               MinColumnSpacing="8" MinRowSpacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="2" Padding="10,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>
    </Grid>
</UserControl>
