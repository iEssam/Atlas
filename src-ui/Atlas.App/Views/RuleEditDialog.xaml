<ContentDialog
    x:Class="Atlas.App.Views.RuleEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Atlas.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
        <StackPanel Spacing="14" MinWidth="440" MaxWidth="520" Margin="0,4,0,0">

            <!-- Name -->
            <StackPanel Spacing="4">
                <TextBlock Text="RULE NAME" Style="{StaticResource AtlasSectionLabelStyle}" />
                <TextBox x:Name="NameBox"
                         AutomationProperties.Name="Rule name"
                         PlaceholderText="e.g. Tame background Chrome" />
            </StackPanel>

            <!-- Match image -->
            <StackPanel Spacing="4">
                <TextBlock Text="MATCH PROCESS IMAGE" Style="{StaticResource AtlasSectionLabelStyle}" />
                <TextBox x:Name="MatchBox"
                         FontFamily="{ThemeResource AtlasMonoFontFamily}"
                         AutomationProperties.Name="Match process image name"
                         PlaceholderText="e.g. chrome.exe" />
                <TextBlock Text="Case-insensitive image name. This rule applies only to processes with this image."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Trigger -->
            <StackPanel Spacing="4">
                <TextBlock Text="WHEN TO APPLY" Style="{StaticResource AtlasSectionLabelStyle}" />
                <ComboBox x:Name="TriggerBox"
                          AutomationProperties.Name="When to apply the rule"
                          HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="While running" Tag="while" />
                    <ComboBoxItem Content="On AC power" Tag="ac" />
                    <ComboBoxItem Content="On battery" Tag="dc" />
                    <ComboBoxItem Content="In fullscreen apps" Tag="fullscreen" />
                </ComboBox>
            </StackPanel>

            <!-- Priority -->
            <StackPanel Spacing="4">
                <TextBlock Text="PRIORITY CLASS" Style="{StaticResource AtlasSectionLabelStyle}" />
                <ComboBox x:Name="PriorityBox"
                          AutomationProperties.Name="Priority class"
                          HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="Unchanged" Tag="unspecified" />
                    <ComboBoxItem Content="Idle" Tag="idle" />
                    <ComboBoxItem Content="Below Normal" Tag="below" />
                    <ComboBoxItem Content="Normal" Tag="normal" />
                    <ComboBoxItem Content="Above Normal" Tag="above" />
                    <ComboBoxItem Content="High" Tag="high" />
                </ComboBox>
            </StackPanel>

            <!-- Affinity -->
            <StackPanel Spacing="4">
                <TextBlock Text="CORE AFFINITY" Style="{StaticResource AtlasSectionLabelStyle}" />
                <ComboBox x:Name="AffinityBox"
                          AutomationProperties.Name="Core affinity mode"
                          HorizontalAlignment="Stretch" SelectedIndex="0"
                          SelectionChanged="AffinityBox_SelectionChanged">
                    <ComboBoxItem Content="Unchanged" Tag="unspecified" />
                    <ComboBoxItem Content="All cores" Tag="all" />
                    <ComboBoxItem Content="Prefer P-cores" Tag="p" />
                    <ComboBoxItem Content="Prefer E-cores" Tag="e" />
                    <ComboBoxItem Content="Custom cores…" Tag="custom" />
                </ComboBox>
                <StackPanel x:Name="CustomMaskPanel" Spacing="4" Visibility="Collapsed">
                    <TextBox x:Name="CustomMaskBox"
                             FontFamily="{ThemeResource AtlasMonoFontFamily}"
                             AutomationProperties.Name="Custom core list"
                             PlaceholderText="e.g. 0-3,8" />
                    <TextBlock x:Name="CustomMaskError"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Comma-separated core numbers and ranges, e.g. 0-3,8." />
                </StackPanel>
            </StackPanel>

            <!-- Eco -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="EcoSwitch"
                              AutomationProperties.Name="Efficiency mode (EcoQoS)"
                              Header="Efficiency mode (EcoQoS)" />
            </StackPanel>

            <!-- Precedence -->
            <StackPanel Spacing="4">
                <TextBlock Text="PRECEDENCE" Style="{StaticResource AtlasSectionLabelStyle}" />
                <NumberBox x:Name="PrecedenceBox"
                           AutomationProperties.Name="Rule precedence"
                           Value="0" SpinButtonPlacementMode="Inline"
                           Minimum="0" Maximum="1000" SmallChange="1" />
                <TextBlock Text="Higher precedence wins when two rules affect the same process."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Enable now -->
            <ToggleSwitch x:Name="EnabledSwitch"
                          AutomationProperties.Name="Enable this rule now"
                          Header="Enable now"
                          OffContent="Saved but not applied"
                          OnContent="Applied to matching processes" />

            <!-- Validation -->
            <InfoBar x:Name="ValidationBar" IsOpen="False" IsClosable="False"
                     Severity="Error" Title="Check the rule" />

            <!-- Preview (the centerpiece) -->
            <Expander x:Name="PreviewExpander"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B3;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Preview impact" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="10" Margin="0,4,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="See exactly which running processes this rule would change - nothing is applied until you save." />
                    <Button x:Name="PreviewButton"
                            Style="{StaticResource AtlasGhostButtonStyle}"
                            AutomationProperties.Name="Run preview"
                            Content="Run preview"
                            Click="PreviewButton_Click" />
                    <views:SimulationResultView x:Name="SimView" MinHeight="80" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
