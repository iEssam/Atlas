<ContentDialog
    x:Class="Atlas.App.Views.SafeActionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <StackPanel Spacing="12" MinWidth="360" MaxWidth="440">
        <TextBlock Text="GUARDED SYSTEM ACTION"
                   Style="{StaticResource AtlasSectionLabelStyle}" />
        <!-- Target + reversibility -->
        <TextBlock x:Name="TargetText" TextWrapping="Wrap"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Name="ReversibilityText" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Risk picture -->
        <Border x:Name="RiskCard"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="2" Padding="12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="RiskIcon" Glyph="&#xE7BA;" FontSize="16"
                              VerticalAlignment="Center" />
                    <TextBlock Text="RISK AND REVERSIBILITY"
                               Style="{StaticResource AtlasSectionLabelStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="RiskText" TextWrapping="Wrap"
                           AutomationProperties.Name="Risk summary" />
            </StackPanel>
        </Border>

        <!-- Denial / status -->
        <InfoBar x:Name="DenialBar" IsOpen="False" IsClosable="False"
                 Severity="Error" Title="Not allowed" />
        <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False"
                 Severity="Informational" />

        <ProgressRing x:Name="BusyRing" IsActive="False"
                      HorizontalAlignment="Left" Width="20" Height="20" />
    </StackPanel>
</ContentDialog>
