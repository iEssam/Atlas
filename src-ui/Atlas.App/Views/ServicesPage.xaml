<Page
    x:Class="Atlas.App.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Services" Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Windows services with state, start type, host PID and account. Read-only inventory." />
        </StackPanel>

        <!-- ===== Filter ===== -->
        <TextBox Grid.Row="1"
                 x:Name="FilterBox"
                 AutomationProperties.Name="Filter services by name"
                 PlaceholderText="Filter by name…"
                 Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- ===== Status line + read-only note ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       ToolTipService.ToolTip="Service actions are not available from this read-only inventory."
                       Text="· READ-ONLY" />
        </StackPanel>

        <!-- ===== Table / empty / unavailable ===== -->
        <Grid Grid.Row="3">
            <!-- Unavailable placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Services unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Text="The connected service is too old to list services."
                           Style="{StaticResource AtlasEmptyStateBodyStyle}" />
            </StackPanel>

            <!-- Empty placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No services match"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
            </StackPanel>

            <Grid Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column header -->
                <Grid Grid.Row="0" Padding="12,0,12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition Width="Auto" MinWidth="120" />
                        <ColumnDefinition Width="Auto" MinWidth="60" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DISPLAY NAME"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="SERVICE NAME"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="STATE"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="START TYPE"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="PID"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                    <TextBlock Grid.Column="5" Text="ACCOUNT"
                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                </Grid>

                <!-- Virtualized rows -->
                <ListView Grid.Row="1"
                          AutomationProperties.Name="Services table"
                          ItemContainerStyle="{StaticResource AtlasRowContainerStyle}"
                          ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedService, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="Auto" MinWidth="100" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" MinWidth="60" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{x:Bind DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind ServiceName}"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- State: colored dot + label -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{x:Bind StateSeverity, Converter={StaticResource ServiceSeverityToBrush}}" />
                                    <TextBlock Text="{x:Bind StateText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind StartTypeText}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind PidText}" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                           Text="{x:Bind Account}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ===== Detail pane for the selected service ===== -->
        <Border Grid.Row="4"
                Style="{StaticResource AtlasPanelStyle}"
                Margin="0,4,0,0"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Text="SELECTED SERVICE" Style="{StaticResource AtlasSectionLabelStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedService.DisplayName, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedService.Description, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="BINARY PATH" Style="{StaticResource AtlasSectionLabelStyle}"
                           Margin="0,4,0,0" />
                <Border Style="{StaticResource AtlasInsetStyle}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedService.BinaryPath, Mode=OneWay}"
                               Style="{StaticResource AtlasMonoStyle}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
