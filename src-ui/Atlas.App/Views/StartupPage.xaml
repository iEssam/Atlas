<Page
    x:Class="Atlas.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title + refresh -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Startup" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock VerticalAlignment="Bottom"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="What runs when Windows starts" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh startup inventory"
                    Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status line + read-only note -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       ToolTipService.ToolTip="Enabling and disabling startup entries is coming soon."
                       Text="• Read-only" />
        </StackPanel>

        <!-- Content / empty / unavailable -->
        <Grid Grid.Row="2">
            <!-- Unavailable placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Startup inventory unavailable"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="The connected service is too old to list startup entries."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="380"
                           HorizontalTextAlignment="Center" />
            </StackPanel>

            <!-- Empty placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE72E;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No startup entries"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Grouped table -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupGroup">
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{x:Bind Title}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           Margin="0,0,0,8" />

                                <!-- Column header -->
                                <Grid Padding="16,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Command"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Publisher"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="State"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="Scope"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StartupItem">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="2"
                                                    Padding="16,8" Margin="0,0,0,6">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                                        <ColumnDefinition Width="Auto" MinWidth="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                               Text="{x:Bind Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind SourceText}" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                               Text="{x:Bind CommandText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontFamily="Consolas"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               ToolTipService.ToolTip="{x:Bind CommandFull}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                               Text="{x:Bind Publisher}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- Enabled/disabled pill -->
                                                    <Border Grid.Column="3" VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            CornerRadius="2" Padding="10,2"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <TextBlock Text="{x:Bind EnabledText}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                               Text="{x:Bind Scope}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
