<Page
    x:Class="Atlas.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="INVENTORY / STARTUP" Style="{StaticResource AtlasEyebrowStyle}" />
                <TextBlock Text="Startup" Style="{StaticResource AtlasPageHeadingStyle}" />
                <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                           Text="What runs when Windows starts, grouped by source. Read-only - measured entries only." />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource AtlasGhostButtonStyle}"
                    AutomationProperties.Name="Refresh startup inventory"
                    Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Status line + read-only note ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       ToolTipService.ToolTip="Enabling and disabling startup entries is coming soon."
                       Text="· READ-ONLY" />
        </StackPanel>

        <!-- ===== Content / empty / unavailable ===== -->
        <Grid Grid.Row="2">
            <!-- Unavailable placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Startup inventory unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                <TextBlock Text="The connected service is too old to list startup entries."
                           Style="{StaticResource AtlasEmptyStateBodyStyle}" />
            </StackPanel>

            <!-- Empty placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE72E;" FontSize="28"
                          Foreground="{ThemeResource AtlasDimBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No startup entries"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}" />
            </StackPanel>

            <!-- Grouped table -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupGroup">
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{x:Bind Title}"
                                           Style="{StaticResource AtlasSectionLabelStyle}"
                                           Margin="2,0,0,8" />

                                <!-- Column header -->
                                <Grid Padding="12,0,12,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="NAME"
                                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="1" Text="COMMAND"
                                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="2" Text="PUBLISHER"
                                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="3" Text="STATE"
                                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="4" Text="SCOPE"
                                               Style="{StaticResource AtlasColumnHeaderStyle}" />
                                </Grid>

                                <!-- Rows -->
                                <Border Style="{StaticResource AtlasPanelFlatStyle}">
                                    <ItemsControl ItemsSource="{x:Bind Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StartupItem">
                                                <Border BorderBrush="{ThemeResource AtlasLineBrush}"
                                                        BorderThickness="0,0,0,1" Padding="12,9">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.4*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="Auto" MinWidth="90" />
                                                            <ColumnDefinition Width="Auto" MinWidth="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                                   Text="{x:Bind Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{x:Bind SourceText}" />
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                                   Text="{x:Bind CommandText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{x:Bind CommandFull}" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                                   Text="{x:Bind Publisher}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <!-- Enabled/disabled pill -->
                                                        <Border Grid.Column="3" HorizontalAlignment="Left"
                                                                Style="{StaticResource AtlasStatusPillStyle}">
                                                            <TextBlock Text="{x:Bind EnabledText}"
                                                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                                                       FontSize="11" />
                                                        </Border>
                                                        <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                                   Text="{x:Bind Scope}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
