<Page
    x:Class="Atlas.App.Views.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Page heading + refresh ===== -->
            <Grid Grid.Row="0">
                <StackPanel Spacing="4">
                    <TextBlock Text="OBSERVE / SENSORS" Style="{StaticResource AtlasEyebrowStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Sensors" Style="{StaticResource AtlasPageHeadingStyle}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="16" Height="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                               Text="Battery, thermal, and startup history. Measured hardware values only - sensors the device does not expose are stated plainly." />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource AtlasGhostButtonStyle}"
                        Content="Refresh"
                        AutomationProperties.Name="Refresh sensors"
                        Click="Refresh_Click" />
            </Grid>

            <!-- ===== Battery section ===== -->
            <Border Grid.Row="1" Style="{StaticResource AtlasPanelStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE83F;" FontSize="13"
                                  Foreground="{ThemeResource AtlasMutedBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="BATTERY" Style="{StaticResource AtlasSectionLabelStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Unsupported (service too old) - honest degradation note -->
                    <TextBlock Text="{x:Bind ViewModel.BatteryNote, Mode=OneWay}"
                               Style="{StaticResource AtlasWarningTextStyle}"
                               Visibility="{x:Bind ViewModel.BatteryUnsupported, Mode=OneWay}" />

                    <!-- Absent (no battery - desktop) - calm, not an error -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.BatteryAbsent, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7F4;" FontSize="14"
                                  Foreground="{ThemeResource AtlasDimBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.BatteryNote, Mode=OneWay}"
                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Present -->
                    <StackPanel Spacing="10"
                                Visibility="{x:Bind ViewModel.BatteryPresent, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.BatteryPercentText, Mode=OneWay}"
                                       Style="{StaticResource AtlasMetricValueStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.BatteryStateText, Mode=OneWay}"
                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{x:Bind ViewModel.BatteryPercentValue, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind ViewModel.BatteryHealthText, Mode=OneWay}"
                                       Style="{StaticResource AtlasMonoMutedStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.BatteryCycleText, Mode=OneWay}"
                                       Style="{StaticResource AtlasMonoMutedStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Thermal section ===== -->
            <Border Grid.Row="2" Style="{StaticResource AtlasPanelStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9CA;" FontSize="13"
                                  Foreground="{ThemeResource AtlasMutedBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="THERMAL" Style="{StaticResource AtlasSectionLabelStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Unsupported (service too old) - honest degradation note -->
                    <TextBlock Text="{x:Bind ViewModel.ThermalNote, Mode=OneWay}"
                               Style="{StaticResource AtlasWarningTextStyle}"
                               Visibility="{x:Bind ViewModel.ThermalUnsupported, Mode=OneWay}" />

                    <!-- Absent (no thermal sensors exposed) - honest, no alarm -->
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.ThermalAbsent, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                      Foreground="{ThemeResource AtlasDimBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ThermalNote, Mode=OneWay}"
                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sensor list -->
                    <StackPanel Spacing="0"
                                Visibility="{x:Bind ViewModel.ThermalPresent, Mode=OneWay}">
                        <Grid ColumnSpacing="12" Padding="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="90" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SENSOR"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="TEMP" HorizontalTextAlignment="Right"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="SOURCE"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Sensors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThermalSensorItem">
                                    <Border BorderBrush="{ThemeResource AtlasLineBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" MinWidth="90" />
                                                <ColumnDefinition Width="1.4*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                       Style="{StaticResource AtlasMonoStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TemperatureText}"
                                                       Style="{StaticResource AtlasMonoStyle}"
                                                       HorizontalTextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SourceText}"
                                                       Style="{StaticResource AtlasMonoMutedStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Startup history (boots) section ===== -->
            <Border Grid.Row="3" Style="{StaticResource AtlasPanelStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7E8;" FontSize="13"
                                  Foreground="{ThemeResource AtlasMutedBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="STARTUP HISTORY" Style="{StaticResource AtlasSectionLabelStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Unsupported (service too old) - honest degradation note -->
                    <TextBlock Text="{x:Bind ViewModel.BootsNote, Mode=OneWay}"
                               Style="{StaticResource AtlasWarningTextStyle}"
                               Visibility="{x:Bind ViewModel.BootsUnsupported, Mode=OneWay}" />

                    <!-- Absent (no boot log) - honest, no alarm -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.BootsAbsent, Mode=OneWay}">
                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                  Foreground="{ThemeResource AtlasDimBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.BootsNote, Mode=OneWay}"
                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Boot list -->
                    <StackPanel Spacing="0"
                                Visibility="{x:Bind ViewModel.BootsPresent, Mode=OneWay}">
                        <Grid ColumnSpacing="12" Padding="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="Auto" MinWidth="90" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BOOT"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="DURATION"
                                       HorizontalTextAlignment="Right"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="STATUS"
                                       Style="{StaticResource AtlasColumnHeaderStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Boots, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BootItem">
                                    <Border BorderBrush="{ThemeResource AtlasLineBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="Auto" MinWidth="90" />
                                                <ColumnDefinition Width="1.4*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TimeText}"
                                                       Style="{StaticResource AtlasMonoStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DurationText}"
                                                       Style="{StaticResource AtlasMonoStyle}"
                                                       HorizontalTextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{x:Bind DegradedToken, Converter={StaticResource MonitorTokenToBrush}}" />
                                                <TextBlock Text="{x:Bind DegradedText}"
                                                           Style="{StaticResource AtlasMonoMutedStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
