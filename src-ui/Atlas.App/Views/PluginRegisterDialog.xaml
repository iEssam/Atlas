<ContentDialog
    x:Class="Atlas.App.Views.PluginRegisterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Register a plugin"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Spacing="14" MinWidth="460" MaxWidth="540" Margin="0,4,0,0">

            <TextBlock Text="PLUGIN REGISTRATION / READ ONLY"
                       Style="{StaticResource AtlasSectionLabelStyle}" />

            <!-- What a plugin is (the framing, up front) -->
            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="A plugin is a separate, signed program that runs in its own process and can only read the slices of Atlas data you grant below. It can never change your system through Atlas, and it stays off until you enable it." />

            <!-- Executable picker -->
            <StackPanel Spacing="4">
                <TextBlock Text="Plugin executable" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontFamily="{ThemeResource AtlasMonoFontFamily}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0"
                             AutomationProperties.Name="Plugin executable path"
                             PlaceholderText="Choose a signed .exe…"
                             IsReadOnly="True" />
                    <Button x:Name="BrowseButton" Grid.Column="1"
                            AutomationProperties.Name="Choose plugin executable"
                            Style="{StaticResource AtlasGhostButtonStyle}"
                            Content="Choose…"
                            Click="OnBrowseClick" />
                </Grid>
            </StackPanel>

            <!-- Capabilities to grant -->
            <StackPanel Spacing="6">
                <TextBlock Text="Capabilities to grant" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Each is a read-only slice - the plugin gets only what you tick, and can read nothing else. Grant as little as it needs." />
                <ItemsControl x:Name="CapabilityList"
                              AutomationProperties.Name="Capabilities to grant">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CapabilityChoiceViewModel">
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind Label}"
                                      Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Label}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Unsigned opt-in (off, gated behind a clear caution) -->
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="12,10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="15" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="Unsigned plugins" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Atlas verifies a plugin's signature before it can be registered. An unsigned program can't have its publisher confirmed - allow one only if you trust where it came from. It's still read-only and still off until you enable it." />
                    <CheckBox x:Name="AllowUnsignedCheck"
                              AutomationProperties.Name="Allow an unsigned plugin"
                              Content="Allow an unsigned plugin (only if you trust the source)" />
                </StackPanel>
            </Border>

            <!-- Register action + result -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="RegisterButton"
                        AutomationProperties.Name="Register plugin"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Register"
                        Click="OnRegisterClick" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="16" Height="16" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
