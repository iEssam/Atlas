<Page
    x:Class="Atlas.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot" Padding="12" RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="WindowPicker.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="DiagnoseWindowButton.(Grid.Row)" Value="1" />
                        <Setter Target="DiagnoseWindowButton.(Grid.Column)" Value="0" />
                        <Setter Target="IncidentStatus.(Grid.Row)" Value="2" />
                        <Setter Target="IncidentStatus.(Grid.Column)" Value="0" />
                        <Setter Target="IncidentStatus.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="RefreshButton.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshButton.(Grid.Column)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="20" />
                        <Setter Target="IncidentListRow.Height" Value="2*" />
                        <Setter Target="DiagnosisRow.Height" Value="3*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="24" />
                        <Setter Target="WindowPicker.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DiagnoseWindowButton.(Grid.Row)" Value="0" />
                        <Setter Target="DiagnoseWindowButton.(Grid.Column)" Value="1" />
                        <Setter Target="IncidentStatus.(Grid.Row)" Value="0" />
                        <Setter Target="IncidentStatus.(Grid.Column)" Value="2" />
                        <Setter Target="IncidentStatus.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RefreshButton.(Grid.Row)" Value="0" />
                        <Setter Target="RefreshButton.(Grid.Column)" Value="3" />
                        <Setter Target="IncidentListColumn.Width" Value="340" />
                        <Setter Target="DiagnosisColumn.Width" Value="*" />
                        <Setter Target="IncidentListRow.Height" Value="*" />
                        <Setter Target="DiagnosisRow.Height" Value="0" />
                        <Setter Target="DiagnosisPanel.(Grid.Row)" Value="0" />
                        <Setter Target="DiagnosisPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Page heading ===== -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Diagnostics" Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Style="{StaticResource AtlasPageDescriptionStyle}"
                       Text="Explains recorded incidents from measured evidence - read-only, never invented. Facts and correlations are marked apart." />
        </StackPanel>

        <!-- Controls: window + ad-hoc diagnose -->
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="WindowPicker" Grid.Column="0"
                      AutomationProperties.Name="Diagnostics window"
                      MinWidth="160"
                      ItemsSource="{x:Bind ViewModel.Windows}"
                      SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />

            <Button Grid.Column="1"
                    x:Name="DiagnoseWindowButton"
                    Style="{StaticResource AtlasGhostButtonStyle}"
                    AutomationProperties.Name="Diagnose the current window"
                    Content="Diagnose current window"
                    Click="OnDiagnoseWindowClick" />

            <StackPanel x:Name="IncidentStatus" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingIncidents, Mode=OneWay}"
                              Width="16" Height="16" />
                <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.IncidentsStatus, Mode=OneWay}" />
            </StackPanel>

            <Button Grid.Column="3"
                    x:Name="RefreshButton"
                    Style="{StaticResource AtlasGhostButtonStyle}"
                    AutomationProperties.Name="Refresh incidents"
                    Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Body: incident list (left) + diagnosis (right) -->
        <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="IncidentListRow" Height="2*" />
                <RowDefinition x:Name="DiagnosisRow" Height="3*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IncidentListColumn" Width="*" />
                <ColumnDefinition x:Name="DiagnosisColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Incident list -->
            <Border Grid.Column="0" Style="{StaticResource AtlasPanelFlatStyle}">
                <Grid>
                    <!-- Unavailable -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="16"
                                Visibility="{x:Bind ViewModel.IncidentsUnavailable, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="24"
                                  Foreground="{ThemeResource AtlasMutedBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Diagnostics unavailable"
                                   Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                        <TextBlock Text="The connected service is too old to detect incidents."
                                   Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                    </StackPanel>

                    <!-- Empty -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="16"
                                Visibility="{x:Bind ViewModel.IncidentsEmpty, Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="24"
                                  Foreground="{ThemeResource AtlasGreenBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No incidents"
                                   Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                        <TextBlock Text="Nothing notable was detected in this window."
                                   Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                    </StackPanel>

                    <!-- List -->
                    <ListView AutomationProperties.Name="Detected incidents"
                              ItemsSource="{x:Bind ViewModel.Incidents, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedIncident, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IncidentRowViewModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Glyph="{x:Bind KindGlyph}" FontSize="18"
                                              Foreground="{x:Bind SeverityToken, Converter={StaticResource SeverityToBrush}}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind KindLabel}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Border Style="{StaticResource AtlasStatusPillStyle}"
                                                    Padding="6,1">
                                                <TextBlock Text="{x:Bind SeverityLabel}"
                                                           Style="{StaticResource AtlasSectionLabelStyle}"
                                                           Foreground="{x:Bind SeverityToken, Converter={StaticResource SeverityToBrush}}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind TimeText}"
                                                   Style="{StaticResource AtlasMonoMutedStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Diagnosis panel -->
            <Grid x:Name="DiagnosisPanel" Grid.Row="1" Grid.Column="0">
                <!-- Idle -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            MaxWidth="420"
                            Visibility="{x:Bind ViewModel.DiagnosisIdle, Mode=OneWay}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28"
                              Foreground="{ThemeResource AtlasMutedBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Select an incident to diagnose"
                               Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                    <TextBlock Text="Pick an incident on the left, or diagnose the whole window. Atlas explains what was measured and how sure it is - it never guesses."
                               Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                </StackPanel>

                <!-- Busy -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsDiagnosing, Mode=OneWay}"
                                  Width="32" Height="32" />
                    <TextBlock Text="Diagnosing…"
                               Style="{StaticResource AtlasMonoMutedStyle}" />
                </StackPanel>

                <!-- Unsupported (server too old) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            MaxWidth="420"
                            Visibility="{x:Bind ViewModel.DiagnosisUnsupported, Mode=OneWay}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="28"
                              Foreground="{ThemeResource AtlasMutedBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Diagnostics unavailable"
                               Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DiagnosisMessage, Mode=OneWay}"
                               Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                </StackPanel>

                <!-- Insufficient evidence - a FIRST-CLASS honest state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            MaxWidth="440"
                            Visibility="{x:Bind ViewModel.DiagnosisInsufficient, Mode=OneWay}">
                    <FontIcon Glyph="&#xE946;" FontSize="28"
                              Foreground="{ThemeResource AtlasCyanBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Not enough evidence to diagnose"
                               Style="{StaticResource AtlasEmptyStateTitleStyle}" />
                    <Border Style="{StaticResource AtlasInsetStyle}" Padding="14,10">
                        <TextBlock Text="{x:Bind ViewModel.DiagnosisMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" HorizontalTextAlignment="Center" />
                    </Border>
                    <TextBlock Text="Atlas won't invent an explanation it can't support. Try a wider window, or check that monitoring was on."
                               Style="{StaticResource AtlasEmptyStateBodyStyle}" />
                </StackPanel>

                <!-- Diagnosis -->
                <ScrollViewer Visibility="{x:Bind ViewModel.HasDiagnosis, Mode=OneWay}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" Padding="0,0,8,0">

                        <!-- Header: observed + confidence + window + export -->
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind ViewModel.Diagnosis.Observed, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1" VerticalAlignment="Top"
                                        x:Name="ExportButton"
                                        Style="{StaticResource AtlasGhostButtonStyle}"
                                        AutomationProperties.Name="Export report"
                                        Click="OnExportClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                        <TextBlock Text="Export report" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <!-- Overall confidence badge (calm) -->
                                <Border Style="{StaticResource AtlasStatusPillStyle}" Padding="10,3">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{x:Bind ViewModel.Diagnosis.OverallConfidenceToken, Mode=OneWay, Converter={StaticResource ConfidenceToBrush}}" />
                                        <TextBlock Text="{x:Bind ViewModel.Diagnosis.OverallConfidenceLabel, Mode=OneWay}"
                                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.Diagnosis.WindowText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource AtlasMonoMutedStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Evidence - measured FACTS -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.Diagnosis.HasEvidence, Mode=OneWay}">
                            <TextBlock Text="EVIDENCE" Style="{StaticResource AtlasSectionLabelStyle}" />
                            <TextBlock Text="Measured facts backing this diagnosis."
                                       Style="{StaticResource AtlasMonoMutedStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Diagnosis.Evidence, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EvidenceRowViewModel">
                                        <Grid ColumnSpacing="10" Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="12"
                                                      VerticalAlignment="Top" Margin="0,4,0,0"
                                                      Foreground="{ThemeResource AtlasDimBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                                            <Border Grid.Column="2"
                                                    Visibility="{x:Bind HasMetric}"
                                                    Style="{StaticResource AtlasInsetStyle}"
                                                    Padding="6,1" VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind MetricText}"
                                                           Style="{StaticResource AtlasMonoStyle}"
                                                           FontSize="11.5" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Contributing factors - ranked CORRELATIONS, not proven cause -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.Diagnosis.HasFactors, Mode=OneWay}">
                            <TextBlock Text="LIKELY CONTRIBUTING FACTORS"
                                       Style="{StaticResource AtlasSectionLabelStyle}" />
                            <TextBlock Text="Ranked most likely first. Each shows how confident Atlas is."
                                       Style="{StaticResource AtlasMonoMutedStyle}" />
                            <!-- Honest framing: these are correlations, not established causes -->
                            <TextBlock Style="{StaticResource AtlasWarningTextStyle}"
                                       Text="These are ranked correlations weighted by confidence - correlation, not proven cause." />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Diagnosis.Factors, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FactorRowViewModel">
                                        <Border Style="{StaticResource AtlasPanelStyle}"
                                                Padding="14,10" Margin="0,3">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind RankText}"
                                                           VerticalAlignment="Top"
                                                           Style="{StaticResource AtlasMetricValueStyle}"
                                                           FontSize="16"
                                                           Foreground="{ThemeResource AtlasMutedBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Visibility="{x:Bind HasProcess}"
                                                                   Text="{x:Bind ProcessText}"
                                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                                   FontSize="11.5" />
                                                        <TextBlock Visibility="{x:Bind HasAttribution}"
                                                                   Text="{x:Bind AttributionText}"
                                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                                   FontSize="11.5" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Confidence badge (calm color token) -->
                                                <Border Grid.Column="2" VerticalAlignment="Top"
                                                        Style="{StaticResource AtlasStatusPillStyle}"
                                                        Padding="10,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8"
                                                                 Fill="{x:Bind ConfidenceToken, Converter={StaticResource ConfidenceToBrush}}" />
                                                        <TextBlock Text="{x:Bind ConfidenceLabel}"
                                                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Alternative explanations -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.Diagnosis.HasAlternatives, Mode=OneWay}">
                            <TextBlock Text="ALTERNATIVE EXPLANATIONS"
                                       Style="{StaticResource AtlasSectionLabelStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Diagnosis.Alternatives, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="10" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8B9;" FontSize="12"
                                                      VerticalAlignment="Top" Margin="0,4,0,0"
                                                      Foreground="{ThemeResource AtlasDimBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Action plan: recommendation / risk / reversibility / verification -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="WHAT TO DO" Style="{StaticResource AtlasSectionLabelStyle}" />

                            <Border Visibility="{x:Bind ViewModel.Diagnosis.HasRecommendation, Mode=OneWay}"
                                    Style="{StaticResource AtlasPanelStyle}" Padding="14,10">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="14"
                                                  Foreground="{ThemeResource AtlasCyanBrush}" />
                                        <TextBlock Text="RECOMMENDED ACTION"
                                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Diagnosis.Recommendation, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Visibility="{x:Bind ViewModel.Diagnosis.HasRisk, Mode=OneWay}"
                                        Style="{StaticResource AtlasPanelStyle}" Padding="14,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="RISK"
                                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Diagnosis.Risk, Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1"
                                        Visibility="{x:Bind ViewModel.Diagnosis.HasReversibility, Mode=OneWay}"
                                        Style="{StaticResource AtlasPanelStyle}" Padding="14,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="REVERSIBILITY"
                                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Diagnosis.Reversibility, Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Visibility="{x:Bind ViewModel.Diagnosis.HasVerificationPlan, Mode=OneWay}"
                                    Style="{StaticResource AtlasPanelStyle}" Padding="14,10">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14"
                                                  Foreground="{ThemeResource AtlasMutedBrush}" />
                                        <TextBlock Text="HOW TO VERIFY"
                                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Diagnosis.VerificationPlan, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
