<Page
    x:Class="Atlas.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Atlas.App.ViewModels"
    xmlns:controls="using:Atlas.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Evidence-console heading + Register -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Plugins"
                           Style="{StaticResource AtlasPageHeadingStyle}" />
                <TextBlock Text="Signed, separately hosted extensions with explicit read-only grants."
                           Style="{StaticResource AtlasPageDescriptionStyle}" />
                <Border x:Name="DemoBadge" Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="2" Padding="8,2">
                    <TextBlock Text="Demo data" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
            <Button x:Name="RegisterButton" Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Register a plugin"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="RegisterPlugin_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Register a plugin" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Plain-language explanation (the security framing, up front) -->
        <Border Grid.Row="1" Style="{StaticResource AtlasInsetStyle}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE72E;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock TextWrapping="Wrap" MaxWidth="820"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Plugins are separate, signed programs that can read a chosen slice of Atlas data. They run in their own process, are read-only (a plugin can never change your system through Atlas), and are off until you enable them." />
            </StackPanel>
        </Border>

        <!-- Status line -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
            <TextBlock Style="{StaticResource AtlasMonoMutedStyle}"
                       VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- List / states -->
        <Grid Grid.Row="3">
            <!-- Unavailable -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Plugins unavailable"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="The connected service is too old to manage plugins. Update the Atlas service to register and enable read-only plugins."
                           Style="{StaticResource AtlasEmptyStateBodyStyle}" />
            </StackPanel>

            <!-- Empty -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xEA86;" FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No plugins yet"
                           Style="{StaticResource AtlasEmptyStateTitleStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Register a signed plugin to let it read a slice of Atlas data you choose. Everything stays read-only, and a new plugin is off until you enable it."
                           Style="{StaticResource AtlasEmptyStateBodyStyle}" />
            </StackPanel>

            <!-- List -->
            <ListView AutomationProperties.Name="Registered plugins"
                      ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="0"
                      Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource AtlasRowContainerStyle}" />
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginRowViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="4,2">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: identity + capabilities -->
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <!-- Name + version + signature badge -->
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <controls:AppIcon ExecutablePath="{x:Bind ExePath}" Width="22" Height="22"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind VersionText}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasVersion}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <!-- Signature badge (calm: signed=positive, unsigned=caution) -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="2" Padding="8,2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        ToolTipService.ToolTip="{x:Bind SignatureNote}">
                                                <FontIcon Glyph="{x:Bind SignatureGlyph}" FontSize="13"
                                                          VerticalAlignment="Center"
                                                          Foreground="{x:Bind SignatureToken, Converter={StaticResource SignatureTokenToBrush}}" />
                                                <TextBlock Text="{x:Bind SignatureLabel}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{x:Bind SignatureToken, Converter={StaticResource SignatureTokenToBrush}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Publisher + path -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind PublisherText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ExePath}"
                                                   Style="{StaticResource AtlasMonoMutedStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ExePath}" />
                                    </StackPanel>

                                    <!-- Unsigned caution (calm, only when unsigned) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{x:Bind IsUnsigned}">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="13" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="Unsigned - enable only if you trust the source."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Granted capabilities as chips -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind GrantedCountText}"
                                                   Style="{StaticResource AtlasSectionLabelStyle}" />
                                        <TextBlock Text="No access granted - this plugin can't read anything."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind HasNoCapabilities}" />
                                        <ItemsRepeater ItemsSource="{x:Bind Chips}"
                                                       AutomationProperties.Name="Granted capabilities">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="150" MinItemHeight="28"
                                                                   MinColumnSpacing="8" MinRowSpacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CapabilityChip">
                                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="2" Padding="10,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="12"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind Label}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: enable + actions -->
                                <StackPanel Grid.Column="1" Spacing="8"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <ToggleSwitch HorizontalAlignment="Right"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Enable plugin"
                                                  IsOn="{x:Bind Enabled}"
                                                  OnContent="On" OffContent="Off"
                                                  Toggled="EnabledToggle_Toggled" />
                                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                        <Button AutomationProperties.Name="Edit capabilities"
                                                ToolTipService.ToolTip="Edit capabilities"
                                                Background="Transparent" BorderThickness="0"
                                                Click="EditGrant_Click">
                                            <FontIcon Glyph="&#xE713;" FontSize="15" />
                                        </Button>
                                        <Button AutomationProperties.Name="Remove plugin"
                                                ToolTipService.ToolTip="Remove"
                                                Background="Transparent" BorderThickness="0"
                                                Click="RemovePlugin_Click">
                                            <FontIcon Glyph="&#xE74D;" FontSize="15" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
