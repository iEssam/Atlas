<Page
    x:Class="Atlas.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Evidence-console heading -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="SYSTEM ATLAS / SETTINGS"
                       Style="{StaticResource AtlasEyebrowStyle}" />
            <TextBlock Text="Settings"
                       Style="{StaticResource AtlasPageHeadingStyle}" />
            <TextBlock Text="Export support evidence and configure explicit read-only integrations."
                       Style="{StaticResource AtlasPageDescriptionStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

                <!-- Support bundle card -->
                <Border Style="{StaticResource AtlasPanelStyle}">
                    <StackPanel Spacing="14">

                        <!-- Header -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="SUPPORT EVIDENCE"
                                       Style="{StaticResource AtlasSectionLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="Support bundle"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- What it is -->
                        <TextBlock TextWrapping="Wrap"
                                   Text="Create one self-contained diagnostic file to hand to an IT or support engineer. Atlas assembles it from data it already has - device info, recent health, incidents and diagnoses, system changes, crashes, services, startup, and its own overhead. It's read-only and generated on your machine." />

                        <!-- Safety framing (calm but prominent) -->
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="Made to be shared - redaction is on by default"
                                 Message="Because this file is meant to leave your machine for a support engineer, Atlas removes the personal details you select - user names, computer name, file paths, and command lines - before the file is created, so unrelated personal activity stays off it. You choose exactly what's included and see what was removed." />

                        <!-- Action -->
                        <Button x:Name="CreateBundleButton"
                                AutomationProperties.Name="Create support bundle"
                                Style="{StaticResource AtlasGhostButtonStyle}"
                                Click="CreateBundle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="Create support bundle…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- MCP integration card -->
                <Border Style="{StaticResource AtlasPanelStyle}">
                    <StackPanel Spacing="14">

                        <!-- Header + off-by-default pill -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="READ-ONLY INTEGRATION"
                                           Style="{StaticResource AtlasSectionLabelStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE968;" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="AI client integration (MCP)"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource AtlasStatusPillStyle}">
                                <TextBlock Text="Off by default"
                                           Style="{StaticResource AtlasMonoMutedStyle}" />
                            </Border>
                        </Grid>

                        <!-- What it is -->
                        <TextBlock TextWrapping="Wrap"
                                   Text="Atlas can act as a read-only evidence provider for your own AI client (such as Claude or ChatGPT) through the Model Context Protocol (MCP). Atlas hosts no AI model and generates no answers - it exposes grounded query tools; your client's model does the reasoning and writes the response." />

                        <!-- Separate process -->
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="The integration is a separate, opt-in program - atlas-mcp - that runs only when your AI client starts it. It is off until you register it in that client, and it connects to Atlas with a read-only scope: it can query, but it can never suspend a process, change a rule, or take any action on your system." />

                        <!-- Boundary warning (calm but prominent) -->
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                                 Title="Data leaves Atlas's security boundary when a tool is called"
                                 Message="When you enable this and your AI client calls a tool, the returned data leaves Atlas's security boundary for that client's model provider. Redaction is applied by default - usernames, hostnames, paths, IP addresses, domains, window titles, command lines, and application names become stable pseudonyms before they are returned." />

                        <!-- Tools list -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="What it exposes (read-only)"
                                       Style="{StaticResource AtlasSectionLabelStyle}" />
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Every tool maps to a read-only Atlas query. None of the control surface (stopping processes, changing rules, applying profiles) is reachable through MCP." />

                            <StackPanel Spacing="6" Margin="4,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock><Run FontFamily="{ThemeResource AtlasMonoFontFamily}" Text="list_processes" /><Run Text="  -  current process snapshot (CPU, memory, I/O)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock><Run FontFamily="{ThemeResource AtlasMonoFontFamily}" Text="query_metric_range" /><Run Text="  -  historical metrics for a process or the system" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock><Run FontFamily="{ThemeResource AtlasMonoFontFamily}" Text="list_events" /><Run Text="  -  process start / stop history in a window" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock><Run FontFamily="{ThemeResource AtlasMonoFontFamily}" Text="search" /><Run Text="  -  across processes, events, and bookmarks" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock><Run FontFamily="{ThemeResource AtlasMonoFontFamily}" Text="list_privacy_usage" /><Run Text="  -  camera / microphone / location usage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock><Run FontFamily="{ThemeResource AtlasMonoFontFamily}" Text="list_connections" /><Run Text="  -  active network connections per process" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock><Run FontFamily="{ThemeResource AtlasMonoFontFamily}" Text="list_services / list_startup" /><Run Text="  -  service and startup inventory" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="The exact tool set is defined by the atlas-mcp program; your AI client lists the available tools once it's registered." />
                        </StackPanel>

                        <!-- Config snippet -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Register it in your AI client"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="CopyConfigButton" HorizontalAlignment="Right"
                                        AutomationProperties.Name="Copy MCP client configuration"
                                        Style="{StaticResource AtlasGhostButtonStyle}"
                                        Click="CopyConfig_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="Copy config" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Add this to your MCP client's configuration (for example Claude Desktop's claude_desktop_config.json), then restart the client. Adjust the path to where atlas-mcp is installed." />
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="2" Padding="4">
                                <TextBox x:Name="ConfigBox"
                                         AutomationProperties.Name="MCP client configuration snippet"
                                         IsReadOnly="True" IsSpellCheckEnabled="False"
                                         TextWrapping="NoWrap"
                                         FontFamily="{ThemeResource AtlasMonoFontFamily}" FontSize="13"
                                         BorderThickness="0" Background="Transparent"
                                         AcceptsReturn="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <InfoBar x:Name="CopyStatus" IsOpen="False" IsClosable="True"
                                     Severity="Success" Title="Copied"
                                     Message="The configuration is on your clipboard." />
                        </StackPanel>

                        <!-- Closing note -->
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Atlas does not launch this for you - registration and enablement happen entirely in your AI client. You can remove it there at any time to revoke access." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
