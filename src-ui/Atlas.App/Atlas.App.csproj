<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Atlas.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      MVVMTK0045 advises partial-property [ObservableProperty] for full NativeAOT
      WinRT marshalling. The partial-property form is not yet emitting cleanly
      with CommunityToolkit.Mvvm 8.4.0 + this SDK's XAML compiler, so we keep the
      field form for M5 and revisit before the AOT publish gate (tech-stack §4.6).
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>

    <!--
      Unpackaged, self-contained: runs as a plain .exe without MSIX deploy so
      it can be launched from CLI/dev shells (tech-stack §4.6 prefers this for
      the M5 shell). The Windows App SDK runtime is carried in the output dir.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlas.IpcClient\Atlas.IpcClient.csproj" />
  </ItemGroup>

</Project>
