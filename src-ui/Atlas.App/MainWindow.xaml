<Window
    x:Class="Atlas.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="System Atlas">

    <Grid x:Name="Root" Background="{ThemeResource AtlasGraphiteBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactTitleBar" />
                <VisualState x:Name="WideTitleBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BrandLabel.Visibility" Value="Visible" />
                        <Setter Target="GlobalSearchBox.Width" Value="360" />
                        <Setter Target="GlobalSearchBox.Margin" Value="28,6" />
                        <Setter Target="ShellStatus.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion"
              Grid.Row="0"
              Padding="14,0,146,0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource AtlasCyanBrush}" />
                <TextBlock x:Name="BrandLabel" Text="System Atlas" VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>

            <AutoSuggestBox x:Name="GlobalSearchBox"
                            Grid.Column="1"
                            Width="300"
                            MaxWidth="480"
                            Margin="12,6"
                            HorizontalAlignment="Center"
                            PlaceholderText="Search processes, events, and bookmarks"
                            QueryIcon="Find"
                            AutomationProperties.Name="Search System Atlas"
                            QuerySubmitted="GlobalSearchBox_QuerySubmitted" />

            <StackPanel x:Name="ShellStatus" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon Glyph="{x:Bind ViewModel.CaptureGlyph, Mode=OneWay}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          FontSize="13" />
                <TextBlock Text="{x:Bind ViewModel.CaptureStateText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="220"
                        CompactPaneLength="48"
                        CompactModeThresholdWidth="1008"
                        ExpandedModeThresholdWidth="1280"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" IsSelected="True" Tag="overview">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="performance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Investigate" Tag="investigate">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="System" Tag="system">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE770;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Automation" Tag="automation">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Privacy" Tag="privacy">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Plugins" Tag="plugins">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Spacing="2" Margin="12,8,12,12">
                    <TextBlock Text="{x:Bind ViewModel.DeviceName}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
