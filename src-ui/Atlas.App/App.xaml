<Application
    x:Class="Atlas.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Atlas.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
            <conv:ServiceSeverityToBrushConverter x:Key="ServiceSeverityToBrush" />
            <conv:ConfidenceToBrushConverter x:Key="ConfidenceToBrush" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <conv:TrustTokenToBrushConverter x:Key="TrustTokenToBrush" />
            <conv:BlockedToBrushConverter x:Key="BlockedToBrush" />
            <conv:MonitorTokenToBrushConverter x:Key="MonitorTokenToBrush" />
            <conv:ChangeCategoryToBrushConverter x:Key="ChangeCategoryToBrush" />
            <conv:CrashCautionToBrushConverter x:Key="CrashCautionToBrush" />
            <conv:SignatureTokenToBrushConverter x:Key="SignatureTokenToBrush" />
            <conv:SecurityTokenToBrushConverter x:Key="SecurityTokenToBrush" />
            <conv:CaptureActiveToBrushConverter x:Key="CaptureActiveToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
