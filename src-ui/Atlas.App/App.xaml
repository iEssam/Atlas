<Application
    x:Class="Atlas.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Atlas.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility" />
            <conv:ServiceSeverityToBrushConverter x:Key="ServiceSeverityToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
