<UserControl
    x:Class="Atlas.App.Controls.GamingProofTrack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="260"
          AutomationProperties.Name="Proof Track synchronized gaming trace"
          AutomationProperties.HelpText="A synchronized plot of measured CPU, GPU, memory, temperature, and system events. An accessible summary table follows the plot.">
        <Canvas x:Name="PlotCanvas" SizeChanged="PlotCanvas_SizeChanged">
            <Polyline x:Name="CpuLine"
                      Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                      StrokeThickness="2"
                      StrokeLineJoin="Round" />
            <Polyline x:Name="GpuLine"
                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                      StrokeThickness="2"
                      StrokeLineJoin="Round" />
            <Polyline x:Name="MemoryLine"
                      Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                      StrokeThickness="1.5"
                      StrokeDashArray="4,3"
                      StrokeLineJoin="Round" />
            <Line x:Name="LiveCursor"
                  Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                  StrokeThickness="1"
                  Visibility="Collapsed" />
        </Canvas>
        <TextBlock x:Name="EmptyText"
                   Text="Record or select a session to populate the synchronized trace."
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="420"
                   Style="{StaticResource AtlasPageDescriptionStyle}" />
    </Grid>
</UserControl>
