<UserControl
    x:Class="Atlas.App.Controls.GamingProofTrack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="310"
          AutomationProperties.Name="Proof Track synchronized gaming trace"
          AutomationProperties.HelpText="A synchronized plot with measured frame-time p95 above CPU, GPU, and memory activity. An accessible summary table follows the plot.">
        <Grid x:Name="TraceContent" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="110" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="FrameStatusText"
                       Text="Frame time was not captured for this recording"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <Canvas x:Name="FrameCanvas" Grid.Row="1" SizeChanged="PlotCanvas_SizeChanged">
                <Polyline x:Name="FrameLine"
                          Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round" />
                <Line x:Name="FrameLiveCursor"
                      Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      StrokeThickness="1"
                      Visibility="Collapsed" />
            </Canvas>
            <TextBlock Grid.Row="2"
                       Text="System activity: CPU in green, GPU in foreground, memory dashed"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <Canvas x:Name="PlotCanvas" Grid.Row="3" SizeChanged="PlotCanvas_SizeChanged">
            <Polyline x:Name="CpuLine"
                      Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                      StrokeThickness="2"
                      StrokeLineJoin="Round" />
            <Polyline x:Name="GpuLine"
                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                      StrokeThickness="2"
                      StrokeLineJoin="Round" />
            <Polyline x:Name="MemoryLine"
                      Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                      StrokeThickness="1.5"
                      StrokeDashArray="4,3"
                      StrokeLineJoin="Round" />
            <Line x:Name="LiveCursor"
                  Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                  StrokeThickness="1"
                  Visibility="Collapsed" />
            </Canvas>
        </Grid>
        <TextBlock x:Name="EmptyText"
                   Text="{x:Bind EmptyMessage, Mode=OneWay}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="420"
                   Style="{StaticResource AtlasPageDescriptionStyle}" />
    </Grid>
</UserControl>
