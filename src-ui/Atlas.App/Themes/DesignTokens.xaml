            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF939B98" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF68716E" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF5F6965" />

            <!-- Strokes / dividers -->
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF2A312E" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF2A312E" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF2A312E" />
