            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF151A18" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#11FFFFFF" />

            <!-- Status system fills -> palette -->
