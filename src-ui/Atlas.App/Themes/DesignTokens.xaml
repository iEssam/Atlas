<!--
    System Atlas — design tokens (evidence-console visual language).

    Palette and typography lifted from the product-interface mock. This
    dictionary redefines the WinUI framework theme brushes the pages already
    bind to (Text/Card/Divider/System-fill/Accent), so the whole app recolors
    to the graphite/mineral-cyan/amber system without touching each page.

    The app is forced to Dark (see MainWindow root RequestedTheme); both the
    Dark and Light theme dictionaries carry the same dark values so the look is
    identical regardless of the OS theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================ DARK ============================ -->
        <ResourceDictionary x:Key="Dark">

            <!-- Raw palette (mock CSS variables) -->
            <Color x:Key="AtlasVoid">#FF0B0D0C</Color>
            <Color x:Key="AtlasGraphite">#FF111513</Color>
            <Color x:Key="AtlasPanel">#FF151A18</Color>
            <Color x:Key="AtlasPanel2">#FF191F1D</Color>
            <Color x:Key="AtlasLine">#FF2A312E</Color>
            <Color x:Key="AtlasLineStrong">#FF3B4742</Color>
            <Color x:Key="AtlasInk">#FFECEFE9</Color>
            <Color x:Key="AtlasMuted">#FF939B98</Color>
            <Color x:Key="AtlasDim">#FF68716E</Color>
            <Color x:Key="AtlasLabel">#FF5F6965</Color>
            <Color x:Key="AtlasCyan">#FF7FC6C0</Color>
            <Color x:Key="AtlasCyanLight">#FFA5D8D2</Color>
            <Color x:Key="AtlasCyanDark">#FF254541</Color>
            <Color x:Key="AtlasAmber">#FFC3A06A</Color>
            <Color x:Key="AtlasRed">#FFBF7772</Color>
            <Color x:Key="AtlasGreen">#FF86AA83</Color>

            <!-- Named Atlas brushes (used by our own styles/converters) -->
            <SolidColorBrush x:Key="AtlasVoidBrush" Color="#FF0B0D0C" />
            <SolidColorBrush x:Key="AtlasGraphiteBrush" Color="#FF111513" />
            <SolidColorBrush x:Key="AtlasPanelBrush" Color="#FF151A18" />
            <SolidColorBrush x:Key="AtlasPanel2Brush" Color="#FF191F1D" />
            <SolidColorBrush x:Key="AtlasLineBrush" Color="#FF2A312E" />
            <SolidColorBrush x:Key="AtlasLineStrongBrush" Color="#FF3B4742" />
            <SolidColorBrush x:Key="AtlasInkBrush" Color="#FFECEFE9" />
            <SolidColorBrush x:Key="AtlasMutedBrush" Color="#FF939B98" />
            <SolidColorBrush x:Key="AtlasDimBrush" Color="#FF68716E" />
            <SolidColorBrush x:Key="AtlasLabelBrush" Color="#FF5F6965" />
            <SolidColorBrush x:Key="AtlasCyanBrush" Color="#FF7FC6C0" />
            <SolidColorBrush x:Key="AtlasCyanLightBrush" Color="#FFA5D8D2" />
            <SolidColorBrush x:Key="AtlasCyanDarkBrush" Color="#FF254541" />
            <SolidColorBrush x:Key="AtlasCyanTintBrush" Color="#33254541" />
            <SolidColorBrush x:Key="AtlasAmberBrush" Color="#FFC3A06A" />
            <SolidColorBrush x:Key="AtlasAmberTintBrush" Color="#2EC3A06A" />
            <SolidColorBrush x:Key="AtlasRedBrush" Color="#FFBF7772" />
            <SolidColorBrush x:Key="AtlasGreenBrush" Color="#FF86AA83" />
            <SolidColorBrush x:Key="AtlasGreenTintBrush" Color="#2A86AA83" />

            <!-- Fonts -->
            <FontFamily x:Key="AtlasMonoFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>
            <FontFamily x:Key="AtlasUiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

            <!-- ===== Framework theme-brush overrides (global recolor) ===== -->
            <!-- Page / surface backgrounds -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF111513" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF151A18" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF191F1D" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF111513" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF151A18" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF191F1D" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF151A18" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF191F1D" />

            <!-- Text -->
