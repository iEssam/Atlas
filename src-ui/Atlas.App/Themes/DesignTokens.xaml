            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#2A86AA83" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFC3A06A" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#2EC3A06A" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFBF7772" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#2ABF7772" />
            <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#FF939B98" />
            <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#FF191F1D" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF7FC6C0" />

            <!-- Accent = mineral cyan -->
            <Color x:Key="SystemAccentColor">#FF7FC6C0</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8FCFC9</Color>
            <Color x:Key="SystemAccentColorLight2">#FFA5D8D2</Color>
            <Color x:Key="SystemAccentColorLight3">#FFBCE2DD</Color>
            <Color x:Key="SystemAccentColorDark1">#FF6BB2AC</Color>
            <Color x:Key="SystemAccentColorDark2">#FF579C97</Color>
            <Color x:Key="SystemAccentColorDark3">#FF254541</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF7FC6C0" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E67FC6C0" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC7FC6C0" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF2A312E" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF7FC6C0" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFA5D8D2" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF7FC6C0" />
            <!-- Dark ink text on the cyan accent (buttons) -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF0B0D0C" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#DD0B0D0C" />

            <!-- Square controls -->
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
            <Thickness x:Key="AtlasPagePadding">24</Thickness>

            <!-- NavigationView: evidence-console sidebar -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF111513" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF0D100F" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF0D100F" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF939B98" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFECEFE9" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFECEFE9" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFECEFE9" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFECEFE9" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFECEFE9" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#33254541" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#44254541" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#44254541" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF7FC6C0" />
            <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#FF5F6965" />
        </ResourceDictionary>

